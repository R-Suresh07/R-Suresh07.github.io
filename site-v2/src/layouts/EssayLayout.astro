---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  published: Date;
  updated?: Date;
  topics?: string[];
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, published, updated, topics = [], headings = [] } = Astro.props;
const tableOfContents = headings.filter((heading) => heading.depth === 2);
const formatDate = (date: Date) => new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<BaseLayout title={title} description={description}>
  <article class="essay">
    <div class="essay-grid site-shell">
      {tableOfContents.length > 0 && (
        <aside class="table-of-contents" aria-label="Table of contents">
          <p>Table of contents</p>
          <nav>
            <ol>
              {tableOfContents.map((heading) => (
                <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
      <div class="essay-main">
        <header class="essay-header">
          <h1>{title}</h1>
          <p class="dek">{description}</p>
          <div class="essay-meta">
            <span>Published {formatDate(published)}</span>
            {updated && <span>Updated {formatDate(updated)}</span>}
            {topics.length > 0 && <span>{topics.join(' · ')}</span>}
          </div>
        </header>
        <div class="prose">
          <slot />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const toc = document.querySelector<HTMLElement>('.table-of-contents');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.table-of-contents a')];
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null);

  if (toc && links.length && sections.length) {
    const setActiveLink = (id: string) => {
      links.forEach((link) => link.toggleAttribute('aria-current', link.hash === `#${id}`));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

        if (visible) setActiveLink(visible.target.id);
      },
      { rootMargin: '-20% 0px -65% 0px', threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));
    setActiveLink(sections[0].id);
  }
</script>

<style>
  .essay {
    padding-block: var(--space-6) var(--space-8);
  }

  .essay-grid {
    display: grid;
    grid-template-columns: minmax(11rem, 14rem) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .essay-main {
    min-width: 0;
  }

  .essay-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-line);
    text-align: center;
  }

  .table-of-contents {
    position: sticky;
    top: var(--space-5);
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .table-of-contents > p {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .table-of-contents ol {
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-line);
    list-style: none;
  }

  .table-of-contents a {
    display: block;
    padding: 0.35rem 0 0.35rem var(--space-3);
    border-left: 2px solid transparent;
    color: inherit;
    text-decoration: none;
  }

  .table-of-contents a[aria-current] {
    margin-left: -1px;
    border-left-color: var(--color-accent);
    color: var(--color-accent);
    font-weight: 650;
  }

  .essay-header h1 {
    max-width: 22ch;
    margin: 0 auto;
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: var(--line-height-tight);
    text-wrap: balance;
  }

  .dek {
    max-width: 55ch;
    margin: var(--space-4) auto 0;
    color: var(--color-ink);
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  .essay-meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--color-ink);
    font-size: var(--text-base);
    line-height: 1.35;
  }

  .essay-meta span + span::before {
    content: '·';
    margin-right: var(--space-2);
  }

  :global(.prose h2) {
    scroll-margin-top: var(--space-5);
  }

  @media (max-width: 70rem) {
    .essay-grid {
      display: block;
    }

    .table-of-contents {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .essay {
      padding-top: var(--space-5);
    }

    .essay-header {
      padding-bottom: var(--space-5);
    }

    .essay-meta {
      font-size: var(--text-sm);
    }
  }
</style>
