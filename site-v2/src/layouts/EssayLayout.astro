---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  published: Date;
  updated?: Date;
  authors?: string[];
  affiliation?: string;
  topics?: string[];
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, published, updated, authors = [], affiliation, topics = [], headings = [] } = Astro.props;
const tableOfContents = headings.filter((heading) => heading.depth === 2);
const formatDate = (date: Date) => new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
const formatAuthors = (names: string[]) => {
  if (names.length < 2) return names.join('');
  if (names.length === 2) return names.join(' and ');
  return `${names.slice(0, -1).join(', ')}, and ${names.at(-1)}`;
};
---

<BaseLayout title={title} description={description}>
  <article class="essay">
    <div class="essay-grid site-shell">
      {tableOfContents.length > 0 && (
        <aside class="table-of-contents" aria-label="Table of contents">
          <p>Table of contents</p>
          <nav>
            <ol>
              {tableOfContents.map((heading) => (
                <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
      <div class="essay-main">
        <header class="essay-header">
          <h1>{title}</h1>
          <p class="dek">{description}</p>
          {authors.length > 0 ? (
            <div class="essay-meta essay-byline">
              <strong>By {formatAuthors(authors)} · {formatDate(published)}</strong>
              {affiliation && <em>{affiliation}</em>}
              {updated && <span>Updated {formatDate(updated)}</span>}
            </div>
          ) : (
            <div class="essay-meta">
              <span>Published {formatDate(published)}</span>
              {updated && <span>Updated {formatDate(updated)}</span>}
              {topics.length > 0 && <span>{topics.join(' · ')}</span>}
            </div>
          )}
        </header>
        {tableOfContents.length > 0 && (
          <details class="compact-table-of-contents">
            <summary>On this page</summary>
            <nav aria-label="Table of contents">
              <ol>
                {tableOfContents.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
          </details>
        )}
        <div class="prose">
          <slot />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const toc = document.querySelector<HTMLElement>('.table-of-contents');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.table-of-contents a')];
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null);

  if (toc && links.length && sections.length) {
    const setActiveLink = (id: string) => {
      links.forEach((link) => link.toggleAttribute('aria-current', link.hash === `#${id}`));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

        if (visible) setActiveLink(visible.target.id);
      },
      { rootMargin: '-20% 0px -65% 0px', threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));
    setActiveLink(sections[0].id);
  }
</script>

<style>
  .essay {
    padding-block: var(--space-6) var(--space-8);
  }

  .essay-grid {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--full-width));
    grid-template-columns: minmax(11rem, 14rem) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .essay-main {
    min-width: 0;
    container-type: inline-size;
  }

  .essay-main .prose {
    --breakout-max-width: 100cqw;
    width: min(100%, 100ch);
    margin-inline: auto;
    position: relative;
  }

  .essay-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-line);
    text-align: center;
  }

  .table-of-contents {
    position: sticky;
    top: var(--space-5);
    max-height: calc(100dvh - (2 * var(--space-5)));
    padding-inline-end: var(--space-2);
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.4;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .compact-table-of-contents {
    display: none;
  }

  .table-of-contents > p {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .table-of-contents ol {
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-line);
    list-style: none;
  }

  .table-of-contents a {
    display: block;
    padding: 0.35rem 0 0.35rem var(--space-3);
    border-left: 2px solid transparent;
    color: inherit;
    text-decoration: none;
  }

  .table-of-contents a[aria-current] {
    margin-left: -1px;
    border-left-color: var(--color-accent);
    color: var(--color-accent);
    font-weight: 650;
  }

  .essay-header h1 {
    max-width: 28ch;
    margin: 0 auto;
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: var(--line-height-tight);
    text-wrap: balance;
  }

  .dek {
    max-width: 55ch;
    margin: var(--space-4) auto 0;
    color: var(--color-ink);
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  .essay-meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--color-ink);
    font-size: var(--text-base);
    line-height: 1.35;
  }

  .essay-meta span + span::before {
    content: '·';
    margin-right: var(--space-2);
  }

  .essay-byline {
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .essay-byline em {
    font-size: var(--text-sm);
  }

  :global(.prose h2) {
    scroll-margin-top: var(--space-5);
  }

  @media (max-width: 80rem) {
    .essay-grid {
      display: block;
    }

    .table-of-contents {
      display: none;
    }

    .compact-table-of-contents {
      display: block;
      width: min(100%, var(--measure));
      margin: 0 auto var(--space-5);
      border-block: 1px solid var(--color-line);
      color: var(--color-ink-soft);
      font-family: var(--font-sans);
      font-size: var(--text-sm);
    }

    .compact-table-of-contents summary {
      padding-block: var(--space-3);
      color: var(--color-ink);
      font-weight: 650;
      cursor: pointer;
    }

    .compact-table-of-contents nav {
      max-height: min(50dvh, 24rem);
      padding-bottom: var(--space-3);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .compact-table-of-contents ol {
      margin: 0;
      padding: 0 0 0 var(--space-4);
    }

    .compact-table-of-contents li + li {
      margin-top: var(--space-2);
    }

    .compact-table-of-contents a {
      color: inherit;
      text-decoration: none;
    }

    .compact-table-of-contents a:hover,
    .compact-table-of-contents a:focus-visible {
      color: var(--color-accent);
    }
  }

  @media (min-width: 80.0625rem) {
    .essay-main .prose {
      width: min(calc(100% - 18rem), 100ch);
      margin-inline: auto;
    }
  }

  @media (max-width: 40rem) {
    .essay {
      padding-top: var(--space-5);
    }

    .essay-header {
      padding-bottom: var(--space-5);
    }

    .essay-meta {
      font-size: var(--text-sm);
    }
  }
</style>
