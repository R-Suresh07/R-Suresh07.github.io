---
import FigureHeading from './FigureHeading.astro';
import FigureCaption from './FigureCaption.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  subtitle?: string;
  src: ImageMetadata | string;
  alt: string;
  width?: 'prose' | 'wide' | 'full';
  captionLabel?: string;
  caption?: string;
  emphasizedCaption?: boolean;
  compactTop?: boolean;
  credit?: string;
  source?: string;
}

const {
  title,
  subtitle,
  src,
  alt,
  width = 'prose',
  captionLabel,
  caption,
  emphasizedCaption = false,
  compactTop = false,
  credit,
  source,
} = Astro.props;
---

<figure class:list={['media-figure', `media-figure--${width}`, { 'media-figure--emphasized-caption': emphasizedCaption, 'media-figure--compact-top': compactTop }]}>
  <FigureHeading label={captionLabel} title={title ?? caption} subtitle={subtitle} />
  {typeof src === 'string'
    ? <img src={src} alt={alt} loading="lazy" decoding="async" />
    : <Image src={src} alt={alt} loading="lazy" />}
  <FigureCaption caption={title ? caption : undefined} credit={credit} source={source} />
</figure>

<style>
  .media-figure {
    --media-width: var(--measure);
    width: min(
      var(--media-width),
      var(--breakout-max-width, calc(100vw - (2 * var(--page-gutter))))
    );
    margin-block: var(--space-6);
    margin-inline: 50%;
    transform: translateX(-50%);
  }

  .media-figure--wide {
    --media-width: var(--wide-width);
  }

  .media-figure--compact-top {
    margin-top: var(--space-4);
  }

  .media-figure--full {
    --media-width: var(--full-width);
  }

  .media-figure :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    background: var(--color-paper-raised);
  }

</style>
