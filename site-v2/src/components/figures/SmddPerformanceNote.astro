---
// Best displayed values from the leaderboard screenshot supplied for this article.
const results = [
  { task: 'Lead Optimization', rate: 57.6, models: 'GPT-5.4' },
  { task: 'Scaffold Hopping', rate: 3.8, models: 'GPT-5.4 · Sonnet 4.6 · DeepSeek V3.2 (tied)' },
  { task: 'Interaction Point Discovery', rate: 4.0, models: 'Gemini 3.1 Pro' },
];
---

<span class="performance-note">
  <span class="note-title">Best reported pass rates</span>
  <span class="scale" aria-hidden="true"><span>0%</span><span>100%</span></span>
  {results.map(({ task, rate, models }) => (
    <span class="result">
      <span class="result-heading"><span>{task}</span><strong>{rate.toFixed(1)}%</strong></span>
      <span class="track" aria-hidden="true"><span class="bar" style={`width: ${rate}%`}></span></span>
      <span class="models">{models}</span>
    </span>
  ))}
</span>

<style>
  .performance-note {
    display: block;
    font-family: var(--font-sans);
    font-size: calc(var(--text-xs) * 0.94);
    line-height: 1.4;
  }

  .note-title {
    display: block;
    color: var(--color-ink);
    font-weight: 650;
    margin-bottom: var(--space-2);
  }

  .scale,
  .result-heading {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .scale {
    margin-bottom: 0.45rem;
    font-size: 0.65rem;
    color: var(--color-ink-soft);
  }

  .result {
    display: block;
    margin-bottom: 0.65rem;
  }

  .result-heading {
    align-items: baseline;
    color: var(--color-ink);
  }

  strong {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .track,
  .bar {
    display: block;
    height: 0.35rem;
  }

  .track {
    margin-block: 0.3rem;
    background: var(--color-line);
  }

  .bar {
    background: var(--color-accent);
  }

  .models {
    display: block;
    color: var(--color-ink-soft);
    font-size: 0.65rem;
  }

</style>
