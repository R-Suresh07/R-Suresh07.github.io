</lo-failure-map>

<script>
  class LoFailureMap extends HTMLElement {
    cleanup?: () => void;

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';

      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-mode-button]')];
      const stories = [...this.querySelectorAll<HTMLElement>('[data-story]')];
      const detail = this.querySelector<HTMLElement>('.detail-region')!;
      const restingNote = this.querySelector<HTMLElement>('.resting-note')!;
      const aborter = new AbortController();
      let activeMode: string | null = null;

      const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const collapse = () => {
        activeMode = null;
        delete this.dataset.activeMode;
        buttons.forEach(button => {
          button.classList.remove('active', 'dimmed');
          button.setAttribute('aria-expanded', 'false');
        });
        restingNote.hidden = false;
        const finish = () => {
          if (activeMode !== null) return;
          detail.hidden = true;
          stories.forEach(story => { story.hidden = true; });
        };
        if (prefersReducedMotion()) finish();
        else {
          detail.getAnimations().forEach(animation => animation.cancel());
          const animation = detail.animate(
            [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-6px)' }],
            { duration: 170, easing: 'ease', fill: 'forwards' },
          );
          animation.finished.then(() => {
            animation.cancel();
            finish();
          }).catch(() => {});
        }
      };

      const selectMode = (mode: string) => {
        if (activeMode === mode) {
          collapse();
          return;
        }
        activeMode = mode;
        this.dataset.activeMode = mode;
        buttons.forEach(button => {
          const active = button.dataset.modeButton === mode;
          button.classList.toggle('active', active);
          button.classList.toggle('dimmed', !active);
          button.setAttribute('aria-expanded', String(active));
        });
        stories.forEach(story => { story.hidden = story.dataset.story !== mode; });
        detail.getAnimations().forEach(animation => animation.cancel());
        detail.hidden = false;
        restingNote.hidden = true;
        if (!prefersReducedMotion()) detail.animate(
          [{ opacity: 0, transform: 'translateY(-7px)' }, { opacity: 1, transform: 'translateY(0)' }],
          { duration: 280, easing: 'cubic-bezier(.22,1,.36,1)' },
        );
      };

      buttons.forEach((button, index) => {
        button.addEventListener('click', () => selectMode(button.dataset.modeButton!), { signal: aborter.signal });
        button.addEventListener('keydown', event => {
          if (event.key === 'Escape' && activeMode !== null) {
            event.preventDefault();
            collapse();
            return;
          }
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          const direction = event.key === 'ArrowRight' ? 1 : -1;
          buttons[(index + direction + buttons.length) % buttons.length].focus();
        }, { signal: aborter.signal });
      });

      this.querySelectorAll<HTMLButtonElement>('.turns-toggle').forEach(toggle => {
        toggle.addEventListener('click', () => {
          const turns = toggle.nextElementSibling as HTMLOListElement;
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.firstChild!.textContent = open ? 'hide surrounding turns ' : 'view surrounding turns ';
          toggle.querySelector('span')!.textContent = open ? '↑' : '↓';
          turns.hidden = !open;
        }, { signal: aborter.signal });
      });

      this.cleanup = () => aborter.abort();
    }

    disconnectedCallback() {
      this.cleanup?.();
      delete this.dataset.ready;
    }
  }

  if (!customElements.get('lo-failure-map')) customElements.define('lo-failure-map', LoFailureMap);
</script>

