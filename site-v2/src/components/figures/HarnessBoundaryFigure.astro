<figure class="harness-figure" data-harness-figure>
  <header class="figure-header">
    <span class="figure-label">Fig. 1</span>
    <div>
      <h3>What does the harness actually change?</h3>
    </div>
  </header>

  <div class="interactive-figure">
    <section class="example" aria-label="Interactive view of the CCR2 trajectory">
      <div class="example-heading">
        <p>Real SMDD example · Lead Optimization · CCR2</p>
        <h4>A candidate that passed binding and similarity was ultimately rejected by one structural-alert gate.</h4>
      </div>

      <div class="component-picker">
        <div role="tablist" aria-label="Harness components">
          <button type="button" role="tab" id="harness-tab-representation" aria-controls="harness-view" aria-selected="false" tabindex="-1" data-view="representation">Representation</button>
          <button type="button" role="tab" id="harness-tab-memory" aria-controls="harness-view" aria-selected="false" tabindex="-1" data-view="memory">Memory</button>
          <button type="button" role="tab" id="harness-tab-compaction" aria-controls="harness-view" aria-selected="false" tabindex="-1" data-view="compaction">Compaction</button>
          <button type="button" role="tab" id="harness-tab-tools" aria-controls="harness-view" aria-selected="false" tabindex="-1" data-view="tools">Tools</button>
          <button type="button" role="tab" id="harness-tab-verification" aria-controls="harness-view" aria-selected="true" data-view="verification">Execution / verification</button>
        </div>
      </div>

      <div class="active-view" id="harness-view" role="tabpanel" aria-labelledby="harness-tab-verification" data-active-view>
        <div class="transformation">
          <div class="transform-state">
            <span data-before-label>Candidate evidence</span>
            <strong data-before-title>C014</strong>
            <ul data-before-items>
              <li>binding ✓</li>
              <li>similarity ✓</li>
              <li>structural alert ✕</li>
            </ul>
          </div>

          <div class="harness-operation" aria-hidden="true">
            <code data-operation>Harness</code>
            <svg viewBox="0 0 180 32">
              <path d="M4 16 H166" />
              <path d="m158 9 9 7-9 7" />
            </svg>
          </div>

          <div class="transform-state after-state">
            <span data-after-label>Submission state</span>
            <strong data-after-title>Do not submit normally</strong>
            <ul data-after-items>
              <li>4 evaluator groups passed</li>
              <li>1 required gate failed</li>
            </ul>
          </div>
        </div>

        <p class="view-takeaway" data-takeaway>Runs every required check and converts the evidence into a submission decision.</p>
      </div>
    </section>

    <aside class="evaluator" aria-label="Actual evaluator output for smdd_004_CCR2_16">
      <header>
        <span>Real outcome</span>
        <strong>smdd_004_CCR2_16</strong>
      </header>

      <div class="case-outcome">
        <div><span>Binding</span><strong>0.9426</strong><b class="pass" aria-label="passed">✓</b></div>
        <div><span>Similarity</span><strong>0.80</strong><b class="pass" aria-label="passed">✓</b></div>
        <div class="alert-row"><span>Structural alert</span><strong>match</strong><b class="fail" aria-label="failed">✕</b></div>
      </div>

      <div class="evaluation-groups" data-evaluation-groups data-verification-detail>
        <div data-gate="validity"><span>Validity</span><strong class="pass" aria-label="passed">✓</strong></div>
        <div data-gate="constraints"><span>Hard constraints</span><strong class="fail" aria-label="failed">✕</strong></div>
        <div data-gate="hold"><span>Hold-constant properties</span><strong class="pass" aria-label="passed">✓</strong></div>
        <div data-gate="objective"><span>Optimization objective</span><strong class="pass" aria-label="passed">✓</strong></div>
        <div data-gate="binding"><span>Binding &amp; affinity</span><strong class="pass" aria-label="passed">✓</strong></div>
      </div>

      <div class="constraint-details" data-constraint-details data-verification-detail>
        <p>Hard constraints expanded</p>
        <div><span>MW</span><code>494.5</code><strong class="pass" aria-label="passed">✓</strong></div>
        <div><span>LogP</span><code>1.78</code><strong class="pass" aria-label="passed">✓</strong></div>
        <div><span>TPSA</span><code>119.6</code><strong class="pass" aria-label="passed">✓</strong></div>
        <div><span>Similarity</span><code>0.80</code><strong class="pass" aria-label="passed">✓</strong></div>
        <div><span>PAINS</span><code>clean</code><strong class="pass" aria-label="passed">✓</strong></div>
        <div class="alert-row"><span>Brenk alert</span><code>match</code><strong class="fail" aria-label="failed">✕</strong></div>
      </div>

      <div class="overall-result">
        <span>Overall</span>
        <strong>Failed</strong>
      </div>

      <details>
        <summary>Show molecule details</summary>
        <p>The full SMILES string is intentionally omitted from the default view. Run: <code>smdd_004_CCR2_16</code>.</p>
      </details>
    </aside>
  </div>

</figure>

<script>
  type HarnessView = {
    beforeLabel: string;
    beforeTitle: string;
    beforeItems: string[];
    operation: string;
    afterLabel: string;
    afterTitle: string;
    afterItems: string[];
    takeaway: string;
  };

  const harnessViews: Record<string, HarnessView> = {
    representation: {
      beforeLabel: 'Raw task',
      beforeTitle: 'Task prose',
      beforeItems: ['“Avoid undesirable substructures…”', '“Remain similar…”', '“Improve…”'],
      operation: 'Harness',
      afterLabel: 'Model-facing task',
      afterTitle: 'Explicit conditions',
      afterItems: ['structural alerts: must pass', 'similarity ≥ 0.70', 'optimization objective: must pass'],
      takeaway: 'Turns task prose into explicit conditions the model can reason over.',
    },
    memory: {
      beforeLabel: 'Scattered trajectory state',
      beforeTitle: 'Evidence across turns',
      beforeItems: ['turn 18: similarity = 0.80', 'turn 27: binding = 0.9426', 'turn 31: Brenk alert'],
      operation: 'Harness',
      afterLabel: 'Persistent candidate state',
      afterTitle: 'C014',
      afterItems: ['similarity ✓', 'binding ✓', 'structural alert ✕'],
      takeaway: 'Keeps evidence attached to the molecule it actually describes.',
    },
    compaction: {
      beforeLabel: 'Long trajectory',
      beforeTitle: 'Dozens of observations',
      beforeItems: ['candidate revisions', 'tool outputs', 'old measurements', '…'],
      operation: 'Harness',
      afterLabel: 'Decision-relevant context',
      afterTitle: 'Best candidate: C014',
      afterItems: ['1 failed gate', 'Brenk structural alert', 'do not submit normally'],
      takeaway: 'Drops transcript volume while preserving the evidence that determines the decision.',
    },
    tools: {
      beforeLabel: 'Model intent',
      beforeTitle: '“Test whether C014 binds.”',
      beforeItems: [],
      operation: 'Harness',
      afterLabel: 'Exact operation',
      afterTitle: 'predict_boltz(C014)',
      afterItems: ['protein + pocket fixed', 'result stored on C014'],
      takeaway: 'Turns an intended action into an exact callable operation and stores its result.',
    },
    verification: {
      beforeLabel: 'Candidate evidence',
      beforeTitle: 'C014',
      beforeItems: ['binding ✓', 'similarity ✓', 'structural alert ✕'],
      operation: 'Harness',
      afterLabel: 'Submission state',
      afterTitle: 'Do not submit normally',
      afterItems: ['4 evaluator groups passed', '1 required gate failed'],
      takeaway: 'Runs every required check and converts the evidence into a submission decision.',
    },
  };

  document.querySelectorAll<HTMLElement>('[data-harness-figure]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[data-active-view]')!;
    const verificationDetails = [...root.querySelectorAll<HTMLElement>('[data-verification-detail]')];
    const fields = {
      beforeLabel: root.querySelector<HTMLElement>('[data-before-label]')!,
      beforeTitle: root.querySelector<HTMLElement>('[data-before-title]')!,
      operation: root.querySelector<HTMLElement>('[data-operation]')!,
      afterLabel: root.querySelector<HTMLElement>('[data-after-label]')!,
      afterTitle: root.querySelector<HTMLElement>('[data-after-title]')!,
      takeaway: root.querySelector<HTMLElement>('[data-takeaway]')!,
    };
    const beforeItems = root.querySelector<HTMLUListElement>('[data-before-items]')!;
    const afterItems = root.querySelector<HTMLUListElement>('[data-after-items]')!;

    const fillList = (list: HTMLUListElement, items: string[]) => {
      list.replaceChildren(...items.map((text) => {
        const item = document.createElement('li');
        item.textContent = text;
        return item;
      }));
    };

    const selectView = (key: string, focus = false) => {
      const view = harnessViews[key];
      const selectedTab = tabs.find((tab) => tab.dataset.view === key);
      if (!view || !selectedTab) return;

      tabs.forEach((tab) => {
        const selected = tab === selectedTab;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', selectedTab.id);
      fields.beforeLabel.textContent = view.beforeLabel;
      fields.beforeTitle.textContent = view.beforeTitle;
      fields.operation.textContent = view.operation;
      fields.afterLabel.textContent = view.afterLabel;
      fields.afterTitle.textContent = view.afterTitle;
      fields.takeaway.textContent = view.takeaway;
      fillList(beforeItems, view.beforeItems);
      fillList(afterItems, view.afterItems);
      verificationDetails.forEach((detail) => { detail.hidden = key !== 'verification'; });

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        panel.animate([{ opacity: .35, transform: 'translateY(4px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 180, easing: 'ease-out' });
      }
      if (focus) selectedTab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectView(tab.dataset.view ?? ''));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home' ? 0
          : event.key === 'End' ? tabs.length - 1
          : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        selectView(tabs[nextIndex].dataset.view ?? '', true);
      });
    });

    selectView('verification');
  });
</script>

<style>
  .harness-figure {
    --figure-fail: #b14f3b;
    width: min(var(--full-width), calc(100vw - (2 * var(--page-gutter))));
    margin-block: var(--space-6);
    margin-inline: 50%;
    transform: translateX(-50%);
    color: var(--color-ink);
    font-family: var(--font-sans);
  }

  .figure-header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }

  .figure-label,
  .example-heading p,
  .transform-state > span,
  .evaluator header > span,
  .constraint-details > p,
  .overall-result span {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .figure-header h3,
  .example-heading p,
  .example-heading h4,
  .constraint-details p {
    margin: 0;
  }

  .figure-header h3 {
    font-size: var(--text-xl);
    font-weight: 550;
    letter-spacing: -.025em;
    line-height: 1.1;
  }

  .interactive-figure {
    display: grid;
    grid-template-columns: minmax(0, 1.85fr) minmax(18rem, .72fr);
    gap: var(--space-5);
    padding-block: var(--space-5);
  }

  .example {
    min-width: 0;
  }

  .example-heading h4 {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.25;
  }

  .component-picker {
    margin-top: var(--space-4);
  }

  .component-picker > div {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    margin-top: var(--space-2);
  }

  [role='tab'] {
    padding: .55rem .8rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-soft);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 650;
    cursor: pointer;
  }

  [role='tab']:hover,
  [role='tab'][aria-selected='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: white;
  }

  .active-view {
    margin-top: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: .35rem;
    background: color-mix(in srgb, var(--color-paper-raised) 65%, transparent);
  }

  .transformation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8rem, .62fr) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    min-height: 12rem;
    margin: 0;
  }

  .transform-state {
    min-width: 0;
  }

  .transform-state strong {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-base);
    line-height: 1.3;
  }

  .transform-state ul {
    margin: var(--space-3) 0 0;
    padding: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.65;
    list-style: none;
  }

  .transform-state li::before {
    content: '·';
    margin-right: .5rem;
    color: var(--color-accent);
  }

  .after-state {
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-accent);
  }

  .harness-operation {
    color: var(--color-accent);
    text-align: center;
  }

  .harness-operation code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .harness-operation svg {
    display: block;
    width: 100%;
    margin-block: var(--space-2);
  }

  .harness-operation path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .view-takeaway {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-style: italic;
  }

  .evaluator {
    align-self: start;
    padding: var(--space-4);
    border-radius: .35rem;
    background: #202624;
    color: #edf1ee;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    box-shadow: 0 .75rem 2rem color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .evaluator header > strong,
  .evaluator header > small {
    display: block;
  }

  .evaluator header > span {
    color: #7ec8b5;
  }

  .evaluator header > strong {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
  }

  .evaluator header > small {
    margin-top: .25rem;
    color: #aeb8b3;
    font: inherit;
  }

  .case-outcome {
    margin-block: var(--space-4);
    padding-block: var(--space-3);
    border-block: 1px solid #46504b;
  }

  .case-outcome > div {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-2);
    align-items: center;
    padding-block: .4rem;
  }

  .case-outcome span {
    color: #aeb8b3;
    line-height: 1.3;
  }

  .case-outcome strong {
    color: #edf1ee;
    font-variant-numeric: tabular-nums;
  }

  .evaluation-groups > div,
  .constraint-details > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2);
    align-items: center;
    padding-block: .5rem;
    border-bottom: 1px solid #39413d;
  }

  .pass {
    color: #7ec8b5;
  }

  .fail {
    color: #f08b73;
  }

  .constraint-details {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid #46504b;
  }

  .constraint-details > p {
    margin: 0 0 var(--space-2);
    color: #aeb8b3;
  }

  .constraint-details > div {
    grid-template-columns: 1fr auto auto;
  }

  .evaluator .constraint-details code {
    min-width: 4.8ch;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #edf1ee;
    font: inherit;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .alert-row {
    color: #ffd8cf;
  }

  .overall-result {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 2px solid #edf1ee;
  }

  .overall-result span {
    color: #edf1ee;
  }

  .overall-result strong {
    color: #f08b73;
    font-size: var(--text-base);
    text-transform: uppercase;
  }

  .evaluator details {
    margin-top: var(--space-4);
    color: #aeb8b3;
  }

  .evaluator summary {
    cursor: pointer;
    font-family: var(--font-sans);
  }

  .evaluator details p {
    margin: var(--space-2) 0 0;
    font-family: var(--font-sans);
    line-height: 1.5;
  }

  @media (min-width: 72.01rem) {
    .example-heading h4 {
      white-space: nowrap;
    }
  }

  @media (max-width: 72rem) {
    .interactive-figure {
      grid-template-columns: 1fr;
    }

    .evaluator {
      width: min(100%, 38rem);
    }
  }

  @media (max-width: 52rem) {
    .transformation {
      grid-template-columns: 1fr;
    }

    .after-state {
      padding: var(--space-3) 0 0;
      border-top: 3px solid var(--color-accent);
      border-left: 0;
    }

    .harness-operation {
      display: grid;
      justify-items: center;
    }

    .harness-operation svg {
      width: 5rem;
      transform: rotate(90deg);
    }
  }

  @media (max-width: 40rem) {
    .figure-header {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

  }
</style>
