---
interface Excerpt {
  turn: string;
  text: string;
  warning?: boolean;
}

interface Props {
  model: string;
  excerpts: Excerpt[];
}

const { model, excerpts } = Astro.props;
---

<aside class="model-excerpts" aria-label={`Selected reasoning excerpts from ${model}`}>
  <div class="bot-mark" aria-hidden="true">
    <svg viewBox="0 0 48 48">
      <path d="M24 8v5" />
      <circle cx="24" cy="6" r="2.5" />
      <rect x="9" y="13" width="30" height="25" rx="9" />
      <path d="M9 22H6v8h3m30-8h3v8h-3M18 32h12" />
      <circle cx="18" cy="24" r="2.5" />
      <circle cx="30" cy="24" r="2.5" />
    </svg>
  </div>

  <div class="excerpt-body">
    <header>
      <strong>{model}</strong>
      <span>model trace · lightly trimmed</span>
    </header>
    <div class="excerpt-stack">
      {excerpts.map((excerpt) => (
        <blockquote class:list={{ warning: excerpt.warning }}>
          <span>{excerpt.turn}</span>
          <p>“{excerpt.text}”</p>
        </blockquote>
      ))}
    </div>
  </div>
</aside>

<style>
  .model-excerpts {
    display:grid;
    grid-template-columns:42px minmax(0, 1fr);
    gap:12px;
    max-width:760px;
    margin:20px auto 0;
  }
  .bot-mark {
    display:grid;
    place-items:center;
    width:38px;
    height:38px;
    border:1px solid color-mix(in srgb, var(--accent) 48%, var(--color-line));
    border-radius:50%;
    background:color-mix(in srgb, var(--accent) 7%, var(--color-paper));
    color:var(--accent);
  }
  .bot-mark svg { width:27px; height:27px; overflow:visible; fill:none; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; stroke-width:1.5; }
  .bot-mark svg circle { fill:var(--color-paper); }
  .bot-mark svg circle:nth-last-child(-n + 2) { fill:currentColor; stroke:none; }
  .excerpt-body { min-width:0; }
  .excerpt-body > header { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin:0 0 6px; }
  .excerpt-body > header strong { color:var(--accent); font:8px/1.4 var(--font-mono); font-weight:600; text-transform:uppercase; }
  .excerpt-body > header span { color:var(--color-ink-soft); font:7px/1.4 var(--font-mono); }
  .excerpt-stack { display:grid; gap:6px; }
  blockquote { position:relative; padding:10px 13px 10px 58px; border:1px solid var(--color-line); margin:0; background:color-mix(in srgb, var(--color-paper-raised) 72%, transparent); }
  blockquote::before { position:absolute; top:12px; left:-6px; width:10px; height:10px; border-bottom:1px solid var(--color-line); border-left:1px solid var(--color-line); background:var(--color-paper); content:''; transform:rotate(45deg); }
  blockquote + blockquote::before { display:none; }
  blockquote > span { position:absolute; top:12px; left:13px; color:var(--color-ink-soft); font:7px/1.35 var(--font-mono); text-transform:uppercase; }
  blockquote p { margin:0; color:var(--color-ink); font:12px/1.55 var(--font-serif); }
  blockquote.warning { border-color:color-mix(in srgb, var(--failure) 40%, var(--color-line)); background:var(--failure-soft); }
  blockquote.warning p { color:var(--failure); }

  @media (max-width:580px) {
    .model-excerpts { grid-template-columns:34px minmax(0, 1fr); gap:9px; }
    .bot-mark { width:31px; height:31px; }
    .bot-mark svg { width:22px; height:22px; }
    .excerpt-body > header { align-items:flex-start; flex-direction:column; gap:1px; }
    blockquote { padding:9px 10px; }
    blockquote > span { position:static; display:block; margin-bottom:3px; }
    blockquote p { font-size:11px; }
  }
</style>
