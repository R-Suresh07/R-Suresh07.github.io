---
import FigureHeading from '../FigureHeading.astro';

const comparisons = [
  {
    key: 'lo',
    task: 'Lead Optimization',
    metric: 'Tasks solved',
    total: 68,
    methods: [
      { name: 'V1 baseline', short: 'V1', kind: 'baseline', value: 13 },
      { name: 'Automated search', short: 'AHE', kind: 'ahe', value: 13 },
      { name: 'Manual V2', short: 'Manual V2', kind: 'human', value: 33 },
    ],
    bracketFrom: 13,
    bracketTo: 33,
    primaryDelta: 'Manual V2 +29.4 pp vs V1/AHE',
    minorDelta: 'AHE = V1',
    winner: 'human',
    evidence: [
      ['V2-only wins', '26'],
      ['AHE-only wins', '6'],
      ['Both solve', '7'],
      ['Neither solves', '29'],
    ],
    evidenceSummary: [
      'V2 wins 20 more paired tasks',
      'McNemar exact · p = 5.35 × 10⁻⁴',
    ],
  },
  {
    key: 'ipd',
    task: 'Interaction Point Discovery',
    metric: 'Interaction points recovered',
    total: 75,
    methods: [
      { name: 'V1 baseline', short: 'V1', kind: 'baseline', value: 10 },
      { name: 'Automated search', short: 'AHE', kind: 'ahe', value: 12 },
      { name: 'Manual V2', short: 'Manual V2', kind: 'human', value: 30 },
    ],
    bracketFrom: 12,
    bracketTo: 30,
    primaryDelta: 'Manual V2 +24.0 pp vs AHE',
    minorDelta: 'AHE +2.7 pp vs V1',
    winner: 'human',
    evidence: [
      ['V2 improves', '16'],
      ['AHE improves', '3'],
      ['Tie', '6'],
    ],
    evidenceSummary: [
      'V2 improves 13 more paired tasks',
      'Sign test exact · p = 0.0044',
    ],
  },
  {
    key: 'sh',
    task: 'Scaffold Hopping',
    metric: 'Tasks solved',
    total: 52,
    methods: [
      { name: 'Manual V2', short: 'Manual V2', kind: 'human', value: 1 },
      { name: 'V1 baseline', short: 'V1', kind: 'baseline', value: 2 },
      { name: 'Automated search', short: 'AHE', kind: 'ahe', value: 5 },
    ],
    bracketFrom: 2,
    bracketTo: 5,
    primaryDelta: 'AHE +5.8 pp vs V1',
    minorDelta: 'AHE +7.7 pp vs Manual V2',
    winner: 'ahe',
    evidence: [
      ['AHE-only wins', '4'],
      ['V2-only wins', '0'],
      ['Both solve', '1'],
      ['Neither solves', '47'],
    ],
    evidenceSummary: [
      'AHE wins 4 more paired tasks',
      'McNemar exact · p = 0.125',
    ],
  },
].map(comparison => {
  const endpoints = comparison.methods.map(method => method.value / comparison.total * 100);
  const bracketStart = comparison.bracketFrom / comparison.total * 100;
  const bracketEnd = comparison.bracketTo / comparison.total * 100;
  return {
    ...comparison,
    methods: comparison.methods.map((method, index) => ({ ...method, percent: endpoints[index] })),
    bracketStart,
    bracketWidth: bracketEnd - bracketStart,
  };
});
---

<figure class="human-vs-ahe" aria-label="Comparison of baseline, automated, and manually engineered harnesses across three task families">
  <FigureHeading
    label="FIG. 22"
    title="No single harness wins across tasks"
    subtitle="Same child model · same task instances · only the harness changes"
  />

  <div class="comparison-list">
    {comparisons.map(comparison => (
      <article
        class:list={['comparison-row', comparison.key]}
        tabindex="0"
        style={`--bracket-start:${comparison.bracketStart}%;--bracket-width:${comparison.bracketWidth}%`}
        aria-label={`${comparison.task}. ${comparison.methods.map(method => `${method.name}: ${method.value} of ${comparison.total}`).join('. ')}. ${comparison.primaryDelta}.`}
      >
        <header>
          <h2>{comparison.task}</h2>
          <span>{comparison.metric}</span>
        </header>

        <div class="paired-rails">
          <div class="method-labels" aria-hidden="true">
            {comparison.methods.map(method => <span>{method.name}</span>)}
          </div>

          <div class="rail-plot" aria-hidden="true">
            {comparison.methods.map(method => (
              <div class="rail">
                <i class={`rail-fill ${method.kind}`} style={`width:${method.percent}%`} />
                <b class:list={['endpoint', method.kind, { winner: method.kind === comparison.winner }]} style={`left:${method.percent}%`} />
              </div>
            ))}
            <span class={`difference-bracket ${comparison.winner}`}></span>
            <div class="axis"><span>0</span><span>100%</span></div>
          </div>

          <div class="method-values">
            {comparison.methods.map(method => <span class={method.kind}><b>{method.value}</b> / {comparison.total}</span>)}
          </div>
        </div>

        <div class="comparison-notes" aria-hidden="true">
          <div>
            <span>{comparison.minorDelta}</span>
            <strong class={comparison.winner}>{comparison.primaryDelta}</strong>
          </div>
        </div>

        <aside class="evidence-card" aria-hidden="true">
          <strong>{comparison.task}</strong>
          <dl>
            {comparison.evidence.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
          </dl>
          {comparison.evidenceSummary && <div class="evidence-summary">
            {comparison.evidenceSummary.map(line => <span>{line}</span>)}
          </div>}
        </aside>
      </article>
    ))}
  </div>

  <div class="legend" aria-label="Figure color key">
    <span><i class="baseline"></i>V1 baseline</span>
    <span><i class="ahe"></i>Automated search</span>
    <span><i class="human"></i>Manual V2</span>
    <em>hover or focus a task for paired evidence</em>
  </div>

  <figcaption><strong>No single harness-engineering strategy dominates across all three tasks.</strong> With the same Qwen 3.5 9B child model on matched instances, Manual V2 substantially improves Lead Optimization and Interaction Point Discovery, while automated search produces the strongest Scaffold Hopping result. The advantage therefore depends on the task and its remaining bottleneck rather than one approach uniformly outperforming the other.</figcaption>
</figure>

<style>
  .human-vs-ahe {
    --human:#087c83;
    --human-soft:#d8ebe8;
    --ahe:#a55a3e;
    --ahe-soft:#eadbd3;
    --baseline:#aaa9a3;
    width:min(var(--wide-width), var(--breakout-max-width, calc(100vw - 2 * var(--page-gutter))));
    max-width:calc(100vw - 2 * var(--page-gutter));
    box-sizing:border-box;
    margin:var(--space-6) 0;
    margin-inline:50%;
    transform:translateX(-50%);
    color:var(--color-ink);
    font:14px/1.5 var(--font-sans);
  }
  .comparison-list { border-top:1px solid var(--color-line); }
  .comparison-row { position:relative; min-height:176px; padding:20px 18px 18px; border-bottom:1px solid var(--color-line); outline:none; transition:background-color .16s ease; }
  .comparison-row:hover, .comparison-row:focus { z-index:2; background:color-mix(in srgb,var(--color-paper-raised) 58%,transparent); }
  .comparison-row:focus-visible { outline:2px solid var(--human); outline-offset:-2px; }
  .comparison-row > header { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin-bottom:15px; }
  .comparison-row h2 { margin:0; font:600 13px/1.35 var(--font-mono); letter-spacing:.055em; text-transform:uppercase; }
  .comparison-row header > span { color:var(--color-ink-soft); font:600 11px/1.35 var(--font-mono); letter-spacing:.06em; text-transform:uppercase; }

  .paired-rails { display:grid; grid-template-columns:155px minmax(0,1fr) 74px; align-items:start; gap:18px; }
  .method-labels, .method-values { display:grid; grid-template-rows:repeat(3,28px); align-items:center; }
  .method-labels span { color:var(--color-ink-soft); font:12px/1.3 var(--font-mono); }
  .method-values span { color:var(--color-ink-soft); font:12px/1.3 var(--font-mono); text-align:right; }
  .method-values b { color:var(--color-ink); font-size:14px; font-weight:600; }
  .method-values .human b { color:var(--human); }
  .method-values .ahe b { color:var(--ahe); }
  .method-values .baseline b { color:var(--baseline); }
  .rail-plot { position:relative; display:grid; grid-template-rows:repeat(3,28px) 18px; min-width:0; }
  .rail { position:relative; align-self:center; height:1px; background:var(--color-line); }
  .rail-fill { position:absolute; top:0; left:0; height:1px; background:var(--color-ink-soft); }
  .rail-fill.human { background:var(--human); }
  .rail-fill.ahe { background:var(--ahe); }
  .rail-fill.baseline { background:var(--baseline); }
  .endpoint { position:absolute; top:50%; width:8px; height:8px; border:2px solid var(--color-paper); border-radius:50%; background:var(--color-ink-soft); box-shadow:0 0 0 1px currentColor; transform:translate(-50%,-50%); }
  .endpoint.human { color:var(--human); background:var(--human); }
  .endpoint.ahe { color:var(--ahe); background:var(--ahe); }
  .endpoint.baseline { color:var(--baseline); background:var(--baseline); }
  .endpoint.winner { width:12px; height:12px; }
  .difference-bracket {
    --bracket-inset:3px;
    --bracket-total-inset:6px;
    position:absolute;
    top:88px;
    left:calc(var(--bracket-start) + var(--bracket-inset));
    width:max(2px,calc(var(--bracket-width) - var(--bracket-total-inset)));
    height:7px;
    border-top:1px solid currentColor;
    pointer-events:none;
  }
  .difference-bracket.human { color:var(--human); }
  .difference-bracket.ahe { color:var(--ahe); }
  .difference-bracket::before, .difference-bracket::after {
    position:absolute;
    top:-4px;
    height:5px;
    border-left:1px solid currentColor;
    content:'';
  }
  .difference-bracket::before { left:0; }
  .difference-bracket::after { right:0; }
  .axis { position:absolute; right:0; bottom:-1px; left:0; display:flex; justify-content:space-between; color:var(--color-ink-soft); font:9px/1 var(--font-mono); opacity:.65; }
  .comparison-notes { display:grid; grid-template-columns:155px minmax(0,1fr) 74px; gap:18px; margin-top:5px; }
  .comparison-notes > div { grid-column:2; display:flex; align-items:baseline; justify-content:space-between; gap:16px; font:10px/1.35 var(--font-mono); }
  .comparison-notes span { color:var(--color-ink-soft); }
  .comparison-notes strong { font-size:11px; font-weight:600; }
  .comparison-notes strong.human { color:var(--human); }
  .comparison-notes strong.ahe { color:var(--ahe); }
  .evidence-card { position:absolute; z-index:5; top:54px; right:17px; width:260px; box-sizing:border-box; padding:12px 14px; border:1px solid var(--color-line); background:var(--color-paper-raised); box-shadow:0 12px 28px #0002; opacity:0; visibility:hidden; pointer-events:none; transform:translateY(4px); transition:opacity .14s ease, transform .14s ease, visibility .14s; }
  .comparison-row:hover .evidence-card, .comparison-row:focus .evidence-card { opacity:1; visibility:visible; transform:none; }
  .evidence-card > strong { display:block; margin-bottom:7px; color:var(--human); font:600 11px/1.35 var(--font-mono); letter-spacing:.04em; text-transform:uppercase; }
  .evidence-card dl { margin:0; }
  .evidence-card dl > div { display:flex; justify-content:space-between; gap:15px; padding:3px 0; }
  .evidence-card dt { color:var(--color-ink-soft); font:11px/1.35 var(--font-sans); }
  .evidence-card dd { margin:0; font:600 11px/1.35 var(--font-mono); text-align:right; }
  .evidence-summary { display:grid; gap:2px; margin-top:8px; padding-top:8px; border-top:1px solid var(--color-line); color:var(--color-ink-soft); font:10px/1.4 var(--font-mono); }
  .evidence-summary span:first-child { color:var(--color-ink); font-weight:600; }

  .legend { display:flex; align-items:center; flex-wrap:wrap; gap:8px 18px; padding:12px 18px; border-bottom:1px solid var(--color-line); color:var(--color-ink-soft); font:11px/1.4 var(--font-mono); }
  .legend span { display:flex; align-items:center; gap:7px; }
  .legend i { width:14px; border-top:2px solid currentColor; }
  .legend i.baseline { color:var(--baseline); }
  .legend i.human { color:var(--human); }
  .legend i.ahe { color:var(--ahe); }
  .legend em { margin-left:auto; font-style:normal; }
  figcaption { margin:23px 0 0; color:var(--color-ink-soft); font:14px/1.8 var(--font-sans); }
  figcaption strong { color:var(--color-ink); font-weight:600; }

  @media (max-width:700px) {
    .paired-rails { grid-template-columns:120px minmax(0,1fr) 60px; gap:10px; }
    .comparison-notes { grid-template-columns:120px minmax(0,1fr) 60px; gap:10px; }
    .evidence-card { top:50px; right:12px; }
  }
  @media (max-width:520px) {
    .comparison-row { padding-right:10px; padding-left:10px; }
    .comparison-row > header { align-items:flex-start; flex-direction:column; gap:3px; }
    .paired-rails { grid-template-columns:108px minmax(0,1fr) 54px; gap:7px; }
    .comparison-notes { grid-template-columns:108px minmax(0,1fr) 54px; gap:7px; }
    .comparison-notes > div { align-items:flex-start; flex-direction:column; gap:2px; }
    .method-labels span, .method-values span { font-size:10px; }
    .difference-bracket { --bracket-inset:2px; --bracket-total-inset:4px; }
    .evidence-card { position:relative; top:auto; right:auto; width:100%; margin-top:10px; display:none; box-shadow:none; }
    .comparison-row:hover .evidence-card, .comparison-row:focus .evidence-card { display:block; }
    .legend em { flex-basis:100%; margin-left:0; }
  }
  @media (prefers-reduced-motion:reduce) {
    .comparison-row, .evidence-card { transition:none; }
  }
</style>
