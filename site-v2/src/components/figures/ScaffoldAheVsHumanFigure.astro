---
import FigureHeading from '../FigureHeading.astro';
import searchCsv from '../../content/writing/data/scaffold_ahe_tradeoff_search.csv?raw';
import endpointCsv from '../../content/writing/data/scaffold_matched_endpoint_summary.csv?raw';

const parseCsv = (source: string) => {
  const [headerLine, ...lines] = source.trim().split(/\r?\n/);
  const headers = headerLine.split(',');
  return lines.filter(Boolean).map(line => {
    const values = line.split(',');
    return Object.fromEntries(headers.map((header, index) => [header, values[index] ?? '']));
  });
};

const harnessChanges = [
  { title: 'Base harness', description: 'The model had general chemistry tools but no dedicated scaffold-hopping workflow. It had to remember candidates, manage the search, check requirements, and decide when to submit entirely within its trajectory.', bullets: ['no scaffold-hopping workflow', 'state held inside the trajectory', 'model managed checks and submission'] },
  { title: 'Add a gate-led, cheap-first workflow', description: 'The harness first checks inexpensive novelty and molecular-property requirements across a batch of designs, then sends only promising candidates to the costly binding predictor. It also tracks candidates, results, and remaining oracle budget.', bullets: ['screen inexpensive gates first', 'send promising candidates to binding', 'track candidates, results, and budget'] },
  { title: 'Add pose and interaction verification', description: 'After each binding prediction, the harness compares the candidate’s predicted protein contacts with those of the reference ligand. Candidates are judged on preserving the original interaction pattern, not binding probability alone.', bullets: ['compare predicted protein contacts', 'use the reference ligand as the target', 'check interactions, not binding alone'] },
  { title: 'Favor conservative core replacements', description: 'The harness changes the molecule’s central ring system while keeping its interaction anchors, substituents, and linker lengths largely unchanged. This seeks a genuinely different scaffold without unnecessarily changing the molecule’s shape or binding geometry.', bullets: ['replace the central ring system', 'retain interaction anchors and substituents', 'preserve linker lengths and geometry'] },
  { title: 'Require measured finalists and safety margins', description: 'Only candidates actually evaluated by the binding predictor can be submitted. The harness also asks for novelty and binding results comfortably beyond their thresholds, rather than accepting borderline values.', bullets: ['submit only measured candidates', 'require novelty safety margins', 'avoid borderline binding results'] },
  { title: 'Stress-test the novelty checks', description: 'The harness calculates scaffold and fingerprint similarity in several slightly different ways and uses the least favorable result. Candidates close to a novelty threshold are rejected before submission.', bullets: ['calculate novelty several ways', 'use the least favorable result', 'reject threshold-adjacent candidates'] },
  { title: 'Diversify core edits and use the oracle budget', description: 'Consecutive binding predictions must test meaningfully different core replacements instead of small variations of one idea. The expensive multi-version novelty check is removed so more effort can go toward exploring distinct candidates.', bullets: ['test meaningfully different cores', 'remove the multi-version novelty check', 'spend more budget on distinct candidates'] },
  { title: 'Recheck exact novelty and every predicted pose', description: 'The harness rejects superficial edits that leave the original scaffold largely intact, rechecks novelty on the exact submitted molecule, and examines the predicted pose after every binding call. This produced the selected AHE operating point.', bullets: ['reject superficial scaffold edits', 'recheck novelty on the submitted molecule', 'inspect every predicted binding pose'] },
  { title: 'Submit a measured candidate early', description: 'As soon as one candidate has a binding measurement, the harness submits it to protect against ending with no answer. The search may continue afterward and replace it with a better candidate.', bullets: ['submit after the first binding measurement', 'protect against ending without an answer', 'continue searching for a replacement'] },
  { title: 'Keep improving after the first submission', description: 'The first submission is treated as a safety checkpoint rather than the end of the search. Remaining binding calls are spent testing different core designs, with resubmission whenever a better candidate is found.', bullets: ['treat submission as a checkpoint', 'keep testing different core designs', 'resubmit when a better candidate appears'] },
  { title: 'Set a turn-55 submission deadline', description: 'The harness relaxes the immediate-submission rule and allows more early exploration, but requires an answer by turn 55. After that checkpoint, it can continue improving and resubmit stronger candidates.', bullets: ['allow more early exploration', 'require an answer by turn 55', 'continue improving after the deadline'] },
] as const;

const endpointDetails: Record<string, { interpretation: string; status: string }> = {
  v1: { interpretation: 'V1 kept novelty reliability high, but preserved the reference interaction pattern on only 3 of 39 evaluable submissions.', status: 'Baseline harness' },
  ahe: { interpretation: 'Selected AHE accepted lower novelty reliability, preserved interactions most often, and achieved the strongest matched terminal result.', status: 'Best observed endpoint result' },
  v2: { interpretation: 'Human V2 made novelty deterministic, but preserved the reference interaction pattern on only 1 of 50 evaluable submissions.', status: 'Manual V2 endpoint' },
};

const search = parseCsv(searchCsv).map(row => ({
  iteration: Number(row.display_index), harnessNumber: Number(row.harness_number), selected: row.selected.toLowerCase() === 'true',
  evaluable: Number(row.evaluable_trajectories), noveltyPasses: Number(row.both_novelty_passes),
  novelty: Number(row.novel_scaffold_rate_percent), interactionPasses: Number(row.interaction_passes),
  interaction: Number(row.interaction_preservation_rate_percent), bindingPasses: Number(row.binding_passes),
  binding: Number(row.binding_pass_rate_percent), terminal: Number(row.terminal_successes),
  totalTrajectories: Number(row.total_trajectories), tasksSolved: Number(row.tasks_solved_at_least_once), totalTasks: Number(row.total_tasks), annotation: row.annotation,
}));

const endpoints = parseCsv(endpointCsv).map(row => ({
  key: row.variant, label: row.variant_label, totalTasks: Number(row.total_tasks),
  evaluable: Number(row.evaluable_trajectories), noveltyPasses: Number(row.both_novelty_passes),
  novelty: Number(row.novel_scaffold_rate_percent), interactionPasses: Number(row.interaction_passes),
  interaction: Number(row.interaction_preservation_rate_percent), bindingPasses: Number(row.binding_passes),
  binding: Number(row.binding_pass_rate_percent), solved: Number(row.terminal_successes),
}));

const base = search[0];
const selected = search.find(point => point.selected)!;
const iterationFour = search.find(point => point.iteration === 4)!;
const human = endpoints.find(point => point.key === 'v2')!;
const selectedEndpoint = endpoints.find(point => point.key === 'ahe')!;
const v1Endpoint = endpoints.find(point => point.key === 'v1')!;
const interactionPeak = search.reduce((best, point) => point.interaction > best.interaction ? point : best, search[0]);
const terminalPeak = Math.max(...search.map(point => point.terminal));

const mismatch = search.length !== 11 || harnessChanges.length !== search.length || endpoints.length !== 3
  || search.some(point => point.totalTrajectories !== 80 || point.totalTasks !== 20)
  || base.iteration !== 0 || base.noveltyPasses !== 66 || base.evaluable !== 70 || base.interactionPasses !== 0 || base.terminal !== 0
  || selected.iteration !== 7 || selected.noveltyPasses !== 51 || selected.evaluable !== 70 || selected.interactionPasses !== 11 || selected.terminal !== 9
  || iterationFour.terminal !== 9 || interactionPeak.iteration !== 7 || terminalPeak !== 9
  || selectedEndpoint.noveltyPasses !== 29 || selectedEndpoint.evaluable !== 45 || selectedEndpoint.interactionPasses !== 8 || selectedEndpoint.solved !== 5
  || human.noveltyPasses !== 50 || human.evaluable !== 50 || human.interactionPasses !== 1 || human.solved !== 1
  || v1Endpoint.noveltyPasses !== 36 || v1Endpoint.evaluable !== 39 || v1Endpoint.interactionPasses !== 3 || v1Endpoint.solved !== 2;
if (mismatch) throw new Error('FIG. 25: Scaffold Hopping trade-off data no longer matches its validated totals.');

const domain = { xMin: 60, xMax: 100, yMin: 0, yMax: 20 };
const plot = { left: 94, right: 1082, top: 38, bottom: 392 };
const sx = (value: number) => plot.left + (value - domain.xMin) / (domain.xMax - domain.xMin) * (plot.right - plot.left);
const sy = (value: number) => plot.bottom - (value - domain.yMin) / (domain.yMax - domain.yMin) * (plot.bottom - plot.top);
const searchPath = search.map((point, index) => `${index ? 'L' : 'M'} ${sx(point.novelty)} ${sy(point.interaction)}`).join(' ');
const endpointStyles: Record<string, { className: string; shape: 'circle' | 'square' | 'diamond'; dx: number; dy: number; anchor?: 'start' | 'end' }> = {
  v1: { className: 'v1', shape: 'circle', dx: -13, dy: -14, anchor: 'end' },
  ahe: { className: 'ahe', shape: 'square', dx: 14, dy: -15 },
  v2: { className: 'v2', shape: 'diamond', dx: -13, dy: -14, anchor: 'end' },
};
const iterationLabelOffsets: Record<number, { dx: number; dy: number; anchor?: 'start' | 'end' }> = {
  1: { dx: 10, dy: 16 },
  2: { dx: 11, dy: -10 },
  3: { dx: 10, dy: 17 },
  4: { dx: -11, dy: -10, anchor: 'end' },
  5: { dx: -11, dy: 18, anchor: 'end' },
  6: { dx: -12, dy: -10, anchor: 'end' },
  8: { dx: 11, dy: 17 },
  9: { dx: 11, dy: 17 },
  10: { dx: -11, dy: 18, anchor: 'end' },
};
---

<scaffold-tradeoff-figure data-view="search">
  <figure aria-label="Scaffold Hopping novelty and interaction-preservation trade-off during automated harness search and at matched endpoints">
    <FigureHeading label="FIG. 25" title="AHE traded novelty reliability for interaction preservation" subtitle="Scaffold Hopping · 20 tasks · 4 rollouts per harness" />

    <div class="view-controls">
      <span>VIEW</span>
      <div role="tablist" aria-label="Choose Scaffold Hopping evidence view">
        <button type="button" role="tab" id="fig-25-search-tab" aria-selected="true" aria-controls="fig-25-search">AHE search</button>
        <button type="button" role="tab" id="fig-25-endpoint-tab" aria-selected="false" aria-controls="fig-25-endpoints" tabindex="-1">Matched endpoints</button>
      </div>
    </div>
    <p class="view-note">Search and endpoint results are shown separately because they use different evaluation sets.</p>

    <section class="view-summary search-summary" aria-label="Base to selected AHE comparison">
      <header><span>BASE</span><b aria-hidden="true">→</b><span>SELECTED AHE</span></header>
      <div class="summary-metrics">
        <div><small>Novelty reliability</small><strong>{base.novelty.toFixed(1)}% <i>→</i> {selected.novelty.toFixed(1)}%</strong></div>
        <div><small>Interaction preservation</small><strong>{base.interaction.toFixed(1)}% <i>→</i> {selected.interaction.toFixed(1)}%</strong></div>
        <div><small>Terminal success</small><strong>{base.terminal} <i>→</i> {selected.terminal} / 80</strong></div>
      </div>
      <p>The search gave up some novelty reliability to recover the interaction pattern.</p>
    </section>

    <section class="view-summary endpoint-summary" aria-label="Matched 52-task endpoint comparison" hidden>
      <header><span>MATCHED 52-TASK ENDPOINT</span></header>
      <div class="summary-metrics endpoint-metrics">
        <div><small>V1</small><strong>{v1Endpoint.solved} / 52</strong></div>
        <div><small>Selected AHE</small><strong>{selectedEndpoint.solved} / 52</strong></div>
        <div><small>Human V2</small><strong>{human.solved} / 52</strong></div>
      </div>
      <p>The automated harness preserved interactions more often, but passed the novelty gates less reliably.</p>
    </section>

    <div class="chart-shell">
    <section id="fig-25-search" class="chart-view" role="tabpanel" aria-labelledby="fig-25-search-tab">
      <header><strong>AHE search trajectory</strong><small>Each point is one harness variant evaluated during search. Click a point to inspect what that harness changed and how it performed.</small></header>
      <div class="svg-scroll" tabindex="0" role="region" aria-label="Novelty versus interaction-preservation rate across eleven harness evaluations">
        <svg viewBox="0 0 1160 470" role="img" aria-label="AHE search moved from high novelty with no interaction preservation toward lower novelty with better interaction preservation">
          <defs><marker id="fig-25-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" /></marker></defs>
          <g class="grid" aria-hidden="true">
            {[0, 5, 10, 15, 20].map(tick => <g><line x1={plot.left} x2={plot.right} y1={sy(tick)} y2={sy(tick)} /><text x={plot.left - 13} y={sy(tick) + 4} text-anchor="end">{tick}</text></g>)}
            {[60, 70, 80, 90, 100].map(tick => <g><line x1={sx(tick)} x2={sx(tick)} y1={plot.top} y2={plot.bottom} /><text x={sx(tick)} y={plot.bottom + 22} text-anchor="middle">{tick}</text></g>)}
          </g>
          <path class="trajectory" d={searchPath} />
          <path class="tradeoff-arrow" d={`M ${sx(base.novelty) - 8} ${sy(base.interaction) - 8} Q ${sx(82)} ${sy(11)} ${sx(selected.novelty) + 8} ${sy(selected.interaction) + 7}`} marker-end="url(#fig-25-arrow)" />
          <g class="search-points">
            {search.map(point => <g class:list={['search-point', 'interactive-point', { base: point.iteration === 0, selected: point.selected, 'terminal-peak': point.iteration === 4 }]} data-kind="search" data-index={point.iteration} tabindex="0" role="button" aria-expanded="false" aria-controls="fig-25-inspector" aria-label={`${point.iteration === 0 ? 'Base' : `Iteration ${point.iteration}`}: ${point.novelty.toFixed(1)} percent novelty, ${point.interaction.toFixed(1)} percent interaction preservation, ${point.terminal} of 80 terminal successes`}>
              <title>{point.iteration === 0 ? 'Base' : `Iteration ${point.iteration}`} · {point.annotation} · novelty {point.noveltyPasses}/{point.evaluable} · interaction {point.interactionPasses}/{point.evaluable} · binding {point.bindingPasses}/{point.evaluable} · terminal {point.terminal}/80</title>
              <circle class="hit-area" cx={sx(point.novelty)} cy={sy(point.interaction)} r="17" />
              <circle cx={sx(point.novelty)} cy={sy(point.interaction)} r={point.selected ? 10 : point.iteration === 0 ? 7 : 5.5} />
              {point.iteration === 0 && <text x={sx(point.novelty) + 16} y={sy(point.interaction) - 29}><tspan x={sx(point.novelty) + 16}>BASE</tspan><tspan x={sx(point.novelty) + 16} dy="15">0 / 80 SOLVED</tspan></text>}
              {point.iteration === 7 && <text x={sx(point.novelty) + 15} y={sy(point.interaction) - 23}><tspan x={sx(point.novelty) + 15}>SELECTED · ITER. 7</tspan><tspan x={sx(point.novelty) + 15} dy="15">9 / 80 SOLVED</tspan></text>}
              {iterationLabelOffsets[point.iteration] && <text class="iteration-number" x={sx(point.novelty) + iterationLabelOffsets[point.iteration].dx} y={sy(point.interaction) + iterationLabelOffsets[point.iteration].dy} text-anchor={iterationLabelOffsets[point.iteration].anchor ?? 'start'}>{point.iteration}</text>}
            </g>)}
          </g>
          <g class="axes" aria-hidden="true">
            <line x1={plot.left} x2={plot.right} y1={plot.bottom} y2={plot.bottom} /><line x1={plot.left} x2={plot.left} y1={plot.top} y2={plot.bottom} />
            <text class="axis-label" x={(plot.left + plot.right) / 2} y="455" text-anchor="middle">novelty reliability · % of evaluable trajectories · higher →</text>
            <text class="axis-label" x="20" y={(plot.top + plot.bottom) / 2} text-anchor="middle" transform={`rotate(-90 20 ${(plot.top + plot.bottom) / 2})`}>interaction preservation · % of evaluable trajectories · higher →</text>
          </g>
        </svg>
      </div>
    </section>

    <section id="fig-25-endpoints" class="chart-view" role="tabpanel" aria-labelledby="fig-25-endpoint-tab" hidden>
      <header><strong>Matched 52-task endpoint comparison</strong><small>One rollout per task for V1, selected AHE, and Human V2.</small></header>
      <div class="svg-scroll" tabindex="0" role="region" aria-label="Matched endpoint novelty and interaction-preservation rates">
        <svg viewBox="0 0 1160 470" role="img" aria-label="Selected AHE preserved interactions more often and solved more tasks than V1 or Human V2 on matched endpoints">
          <g class="grid" aria-hidden="true">
            {[0, 5, 10, 15, 20].map(tick => <g><line x1={plot.left} x2={plot.right} y1={sy(tick)} y2={sy(tick)} /><text x={plot.left - 13} y={sy(tick) + 4} text-anchor="end">{tick}</text></g>)}
            {[60, 70, 80, 90, 100].map(tick => <g><line x1={sx(tick)} x2={sx(tick)} y1={plot.top} y2={plot.bottom} /><text x={sx(tick)} y={plot.bottom + 22} text-anchor="middle">{tick}</text></g>)}
          </g>
          <g class="endpoint-points">
            {endpoints.map(point => {
              const style = endpointStyles[point.key]; const px = sx(point.novelty); const py = sy(point.interaction); const radius = point.key === 'ahe' ? 10 : 7;
              return <g class:list={['endpoint-point', 'interactive-point', style.className]} data-kind="endpoint" data-index={point.key} tabindex="0" role="button" aria-expanded="false" aria-controls="fig-25-inspector" aria-label={`${point.label}: ${point.novelty.toFixed(1)} percent novelty, ${point.interaction.toFixed(1)} percent interaction preservation, ${point.solved} of 52 tasks solved`}>
                <circle class="hit-area" cx={px} cy={py} r="18" />
                {style.shape === 'circle' && <circle cx={px} cy={py} r={radius} />}
                {style.shape === 'square' && <rect x={px - radius} y={py - radius} width={radius * 2} height={radius * 2} rx="1" />}
                {style.shape === 'diamond' && <rect x={px - radius * .72} y={py - radius * .72} width={radius * 1.44} height={radius * 1.44} transform={`rotate(45 ${px} ${py})`} />}
                <text x={px + style.dx} y={py + style.dy} text-anchor={style.anchor ?? 'start'}>{point.label.toUpperCase()}</text>
              </g>;
            })}
          </g>
          <g class="axes" aria-hidden="true">
            <line x1={plot.left} x2={plot.right} y1={plot.bottom} y2={plot.bottom} /><line x1={plot.left} x2={plot.left} y1={plot.top} y2={plot.bottom} />
            <text class="axis-label" x={(plot.left + plot.right) / 2} y="455" text-anchor="middle">novelty-gate pass rate · % of evaluable submissions · higher →</text>
            <text class="axis-label" x="20" y={(plot.top + plot.bottom) / 2} text-anchor="middle" transform={`rotate(-90 20 ${(plot.top + plot.bottom) / 2})`}>interaction preservation · % of evaluable submissions · higher →</text>
          </g>
        </svg>
      </div>
    </section>

    <button class="drawer-backdrop" type="button" hidden aria-label="Close harness details"></button>
    <aside id="fig-25-inspector" class="inspector" hidden aria-live="polite" aria-label="Selected harness details">
      <header>
        <div class="inspector-heading">
          <small data-inspector-kicker>ITERATION {selected.iteration} · HARNESS {selected.harnessNumber}</small>
          <div class="inspector-title-row">
            <strong data-inspector-title>{harnessChanges[selected.iteration].title}</strong>
            <span class="change-help">
              <button class="change-help-trigger" type="button" aria-label="Explain this harness change" aria-expanded="false" aria-describedby="fig-25-change-help">?</button>
              <span id="fig-25-change-help" class="change-help-tooltip" role="tooltip" data-inspector-description>{harnessChanges[selected.iteration].description}</span>
            </span>
          </div>
        </div>
        <button class="drawer-close" type="button" aria-label="Close harness details">×</button>
      </header>
      <dl class="inspector-metrics">
        <div><dt>Novelty reliability</dt><dd data-novelty>{selected.noveltyPasses} / {selected.evaluable} · {selected.novelty.toFixed(1)}%</dd></div>
        <div><dt>Interaction preservation</dt><dd data-interaction>{selected.interactionPasses} / {selected.evaluable} · {selected.interaction.toFixed(1)}%</dd></div>
        <div><dt>Binding pass</dt><dd data-binding>{selected.bindingPasses} / {selected.evaluable} · {selected.binding.toFixed(1)}%</dd></div>
        <div><dt data-terminal-label>Terminal success</dt><dd data-terminal>{selected.terminal} / {selected.totalTrajectories}</dd></div>
        <div data-coverage-row><dt>Tasks solved ≥1/4</dt><dd data-coverage>{selected.tasksSolved} / {selected.totalTasks}</dd></div>
      </dl>
      <div class="selection-box"><span>SELECTION</span><strong data-selection>Selected · tied on terminal success, highest interaction preservation</strong></div>
      <section class="changes-section" data-changes-section>
        <h4>What changed</h4>
        <ul data-change-list>{harnessChanges[selected.iteration].bullets.map(bullet => <li>{bullet}</li>)}</ul>
      </section>
      <p class="endpoint-interpretation" data-interpretation hidden></p>
    </aside>
    </div>

    <div class="takeaway">The selected operating point was less reliable on novelty, but much better at preserving interactions.</div>
    <figcaption><strong>AHE moved toward a different Scaffold Hopping operating point.</strong> During search, novelty-gate reliability fell from 94.3% to 72.9%, while interaction preservation rose from 0.0% to 15.7% and terminal success increased from 0/80 to 9/80. On the matched 52-task evaluation, selected AHE preserved the reference interaction pattern on 8/45 evaluable submissions and solved 5/52 tasks, compared with 3/39 and 2/52 for V1 and 1/50 and 1/52 for Human V2. Gate rates use evaluable submissions; terminal success uses all intended tasks.</figcaption>
  </figure>
  <script is:inline type="application/json" class="scaffold-tradeoff-data" set:html={JSON.stringify({ search, endpoints, harnessChanges, endpointDetails })} />
</scaffold-tradeoff-figure>

<script>
  class ScaffoldTradeoffFigure extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const controller = new AbortController(); const { signal } = controller;
      const payload = JSON.parse(this.querySelector('.scaffold-tradeoff-data')!.textContent!);
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const points = [...this.querySelectorAll<SVGGElement>('.interactive-point')];
      const subtitle = this.querySelector<HTMLElement>('.editorial-figure-heading .subtitle')!;
      const searchSummary = this.querySelector<HTMLElement>('.search-summary')!;
      const endpointSummary = this.querySelector<HTMLElement>('.endpoint-summary')!;
      const searchView = this.querySelector<HTMLElement>('#fig-25-search')!;
      const endpointView = this.querySelector<HTMLElement>('#fig-25-endpoints')!;
      const shell = this.querySelector<HTMLElement>('.chart-shell')!;
      const drawer = this.querySelector<HTMLElement>('.inspector')!;
      const backdrop = this.querySelector<HTMLButtonElement>('.drawer-backdrop')!;
      const close = this.querySelector<HTMLButtonElement>('.drawer-close')!;
      const help = this.querySelector<HTMLElement>('.change-help')!;
      const helpTrigger = this.querySelector<HTMLButtonElement>('.change-help-trigger')!;
      const fields = {
        kicker: this.querySelector<HTMLElement>('[data-inspector-kicker]')!, title: this.querySelector<HTMLElement>('[data-inspector-title]')!,
        description: this.querySelector<HTMLElement>('[data-inspector-description]')!, novelty: this.querySelector<HTMLElement>('[data-novelty]')!,
        interaction: this.querySelector<HTMLElement>('[data-interaction]')!, binding: this.querySelector<HTMLElement>('[data-binding]')!,
        terminalLabel: this.querySelector<HTMLElement>('[data-terminal-label]')!, terminal: this.querySelector<HTMLElement>('[data-terminal]')!,
        coverageRow: this.querySelector<HTMLElement>('[data-coverage-row]')!, coverage: this.querySelector<HTMLElement>('[data-coverage]')!,
        selection: this.querySelector<HTMLElement>('[data-selection]')!, changes: this.querySelector<HTMLElement>('[data-changes-section]')!,
        changeList: this.querySelector<HTMLUListElement>('[data-change-list]')!, interpretation: this.querySelector<HTMLElement>('[data-interpretation]')!,
      };
      let activeTrigger: SVGGElement | null = null;
      const setHelpOpen = (open: boolean) => { help.classList.toggle('open', open); helpTrigger.setAttribute('aria-expanded', String(open)); };
      const closeDrawer = (restoreFocus = true) => {
        setHelpOpen(false); drawer.hidden = true; backdrop.hidden = true; shell.classList.remove('drawer-open');
        points.forEach(point => { point.classList.remove('active'); point.setAttribute('aria-expanded', 'false'); });
        if (restoreFocus) activeTrigger?.focus(); activeTrigger = null;
      };
      const openDrawer = (kind: 'search' | 'endpoint', index: string, trigger: SVGGElement) => {
        activeTrigger = trigger;
        points.forEach(point => { const active = point === trigger; point.classList.toggle('active', active); point.setAttribute('aria-expanded', String(active)); });
        if (kind === 'search') {
          const point = payload.search[Number(index)]; const meta = payload.harnessChanges[Number(index)];
          help.hidden = false;
          fields.kicker.textContent = `${point.iteration === 0 ? 'BASE' : `ITERATION ${point.iteration}`} · HARNESS ${point.harnessNumber}`;
          fields.title.textContent = meta.title; fields.description.textContent = meta.description;
          fields.novelty.textContent = `${point.noveltyPasses} / ${point.evaluable} · ${point.novelty.toFixed(1)}%`;
          fields.interaction.textContent = `${point.interactionPasses} / ${point.evaluable} · ${point.interaction.toFixed(1)}%`;
          fields.binding.textContent = `${point.bindingPasses} / ${point.evaluable} · ${point.binding.toFixed(1)}%`;
          fields.terminalLabel.textContent = 'Terminal success'; fields.terminal.textContent = `${point.terminal} / ${point.totalTrajectories}`;
          fields.coverageRow.hidden = false; fields.coverage.textContent = `${point.tasksSolved} / ${point.totalTasks}`;
          fields.selection.textContent = point.selected ? 'Selected · tied on terminal success, highest interaction preservation' : point.iteration === 0 ? 'Base harness' : point.iteration === 4 ? 'Not selected · tied on terminal success' : `Not selected · ${point.terminal} / 80 terminal successes`;
          fields.changes.hidden = false; fields.interpretation.hidden = true;
