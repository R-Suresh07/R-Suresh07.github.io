---
import FigureHeading from '../FigureHeading.astro';
import searchCsv from '../../content/writing/data/ipd_ahe_search.csv?raw';
import pointMatrixCsv from '../../content/writing/data/ipd_ahe_task_point_matrix.csv?raw';
import terminalMatrixCsv from '../../content/writing/data/ipd_ahe_task_terminal_matrix.csv?raw';

const parseCsv = (source: string) => {
  const [headerLine, ...lines] = source.trim().split(/\r?\n/);
  const headers = headerLine.split(',');
  return lines.filter(Boolean).map(line => {
    const values = line.split(',');
    return Object.fromEntries(headers.map((header, index) => [header, values[index] ?? '']));
  });
};

const search = parseCsv(searchCsv).map(row => ({
  iteration: Number(row.display_index),
  harnessNumber: Number(row.harness_number),
  selected: row.selected === 'true',
  terminal: Number(row.successful_trajectories),
  totalTrajectories: Number(row.total_trajectories),
  bestTerminal: Number(row.best_so_far_percent) * Number(row.total_trajectories) / 100,
  matchedPoints: Number(row.matched_points),
  possiblePoints: Number(row.possible_points),
  bestOfFour: Number(row.best_of_four_points),
  bestOfFourPossible: Number(row.best_of_four_possible_points),
  tasksAtOne: Number(row.tasks_with_at_least_1_point),
  tasksAtTwo: Number(row.tasks_with_at_least_2_points),
  tasksAtThree: Number(row.tasks_with_3_points),
  totalTasks: Number(row.total_tasks),
  annotation: row.annotation,
}));

const pointMatrix = parseCsv(pointMatrixCsv).map(row => ({
  id: row.task_id,
  label: row.label,
  values: search.map(point => Number(row[`iter${point.iteration}`])),
}));
const terminalMatrix = parseCsv(terminalMatrixCsv).map(row => ({
  id: row.task_id,
  values: search.map(point => Number(row[`iter${point.iteration}`])),
}));

const mean = (values: number[]) => values.reduce((sum, value) => sum + value, 0) / values.length;
const pearson = (left: number[], right: number[]) => {
  const leftMean = mean(left); const rightMean = mean(right);
  const numerator = left.reduce((sum, value, index) => sum + (value - leftMean) * (right[index] - rightMean), 0);
  const denominator = Math.sqrt(
    left.reduce((sum, value) => sum + (value - leftMean) ** 2, 0)
    * right.reduce((sum, value) => sum + (value - rightMean) ** 2, 0),
  );
  return numerator / denominator;
};

const selected = search.find(point => point.selected)!;
const partialPeak = search.reduce((best, point) => point.matchedPoints > best.matchedPoints ? point : best, search[0]);
const reachedOne = pointMatrix.filter(task => Math.max(...task.values) >= 1).length;
const reachedTwo = pointMatrix.filter(task => Math.max(...task.values) >= 2).length;
const reachedThree = pointMatrix.filter(task => Math.max(...task.values) >= 3).length;
const correlation = pearson(search.map(point => point.terminal), search.map(point => point.matchedPoints));

const dataMismatch = search.length !== 11 || pointMatrix.length !== 20 || terminalMatrix.length !== 20
  || search.some(point => point.totalTrajectories !== 80 || point.possiblePoints !== 240 || point.bestOfFourPossible !== 60 || point.totalTasks !== 20)
  || search.some(point => pointMatrix.reduce((sum, task) => sum + task.values[point.iteration], 0) !== point.bestOfFour)
  || search.some(point => pointMatrix.filter(task => task.values[point.iteration] >= 1).length !== point.tasksAtOne)
  || search.some(point => pointMatrix.filter(task => task.values[point.iteration] >= 2).length !== point.tasksAtTwo)
  || search.some(point => pointMatrix.filter(task => task.values[point.iteration] === 3).length !== point.tasksAtThree)
  || search.some(point => terminalMatrix.reduce((sum, task) => sum + task.values[point.iteration], 0) !== point.terminal)
  || search.some(point => terminalMatrix.filter(task => task.values[point.iteration] > 0).length !== point.tasksAtThree)
  || selected.iteration !== 2 || selected.terminal !== 2 || selected.matchedPoints !== 33
  || partialPeak.iteration !== 7 || partialPeak.terminal !== 1 || partialPeak.matchedPoints !== 43
  || reachedOne !== 20 || reachedTwo !== 17 || reachedThree !== 6
  || Math.round(correlation * 100) / 100 !== 0.29;
if (dataMismatch) throw new Error('FIG. 24: IPD AHE search data no longer matches its validated totals.');

const chart = { left: 76, right: 878, topTop: 56, topBottom: 195, bottomTop: 296, bottomBottom: 458 };
const x = (iteration: number) => chart.left + iteration / 10 * (chart.right - chart.left);
const terminalY = (value: number) => chart.topBottom - value / 3 * (chart.topBottom - chart.topTop);
const pointY = (value: number) => chart.bottomBottom - value / 45 * (chart.bottomBottom - chart.bottomTop);
const rawTerminalPath = search.map((point, index) => `${index ? 'L' : 'M'} ${x(point.iteration)} ${terminalY(point.terminal)}`).join(' ');
const bestTerminalPath = search.reduce((path, point, index) => {
  const pointX = x(point.iteration); const pointY = terminalY(point.bestTerminal);
  return index ? `${path} H ${pointX} V ${pointY}` : `M ${pointX} ${pointY}`;
}, '');
const matchedPointPath = search.map((point, index) => `${index ? 'L' : 'M'} ${x(point.iteration)} ${pointY(point.matchedPoints)}`).join(' ');
---

<ipd-reward-gap data-active-iteration={selected.iteration}>
  <figure aria-label="IPD automated harness search objective and hidden partial progress across 11 evaluations">
    <FigureHeading label="FIG. 24" title="AHE saw only the last step" subtitle="Interaction Point Discovery · 20 tasks · 4 rollouts per harness · terminal success is the optimization reward" />

    <div class="figure-layout">
      <div class="chart-column">
        <div class="chart-key" aria-label="Chart legend">
          <span><i class="raw-key"></i>observed terminal reward</span>
          <span><i class="best-key"></i>best so far</span>
          <em>select an evaluation</em>
        </div>
        <div class="chart-scroll" tabindex="0" role="region" aria-label="Two aligned IPD search curves; scroll horizontally on narrow screens">
          <svg class="search-chart" viewBox="0 0 1000 535" role="img" aria-label="Terminal successes and matched interaction points across eleven harness evaluations">
            <g class="panel-labels" aria-hidden="true">
              <text class="panel-kicker coral" x={chart.left} y="17">WHAT AHE SAW</text>
              <text class="panel-title" x={chart.left} y="34">successful trajectories / 80</text>
              <text class="panel-kicker" x={chart.left} y="258">WHAT THE REWARD HID</text>
              <text class="panel-title" x={chart.left} y="276">matched interaction points / 240</text>
              <text class="diagnostic-label" x={chart.right} y="276" text-anchor="end">POST-HOC DIAGNOSTIC · NOT PROVIDED TO AHE</text>
            </g>

            <g class="grid" aria-hidden="true">
              {[0, 1, 2, 3].map(tick => <g><line x1={chart.left} x2={chart.right} y1={terminalY(tick)} y2={terminalY(tick)} /><text x={chart.left - 14} y={terminalY(tick) + 4} text-anchor="end">{tick}</text></g>)}
              {[0, 15, 30, 45].map(tick => <g><line x1={chart.left} x2={chart.right} y1={pointY(tick)} y2={pointY(tick)} /><text x={chart.left - 14} y={pointY(tick) + 4} text-anchor="end">{tick}</text></g>)}
            </g>

            <g class="milestone-guides" aria-hidden="true">
              <line class="selected-guide" x1={x(2)} x2={x(2)} y1={chart.topTop} y2={chart.bottomBottom} />
              <line class="peak-guide" x1={x(7)} x2={x(7)} y1={chart.topTop} y2={chart.bottomBottom} />
              <g class="selected-annotation"><text x={x(2) + 8} y={chart.topTop + 13}>selected by terminal reward</text><text x={x(2) + 8} y={chart.topTop + 26}>first 2 / 80</text></g>
              <g class="peak-annotation"><text x={x(7) + 8} y={chart.bottomTop + 13}>highest partial recovery</text><text x={x(7) + 8} y={chart.bottomTop + 26}>43 / 240</text></g>
            </g>

            <path class="terminal-best" d={bestTerminalPath} />
            <path class="terminal-raw" d={rawTerminalPath} />
            <path class="point-raw" d={matchedPointPath} />

            <g class="correlation" aria-hidden="true">
              <line x1={chart.left} x2={chart.right} y1="232" y2="232" />
              <rect x="535" y="220" width="343" height="24" />
              <text x={chart.right} y="236" text-anchor="end">terminal reward vs. partial recovery · Pearson r = {correlation.toFixed(2)}</text>
            </g>

            <g class="evaluations">
              {search.map(point => <g class:list={['evaluation', { selected: point.selected }]} data-point={point.iteration} tabindex="0" role="button" aria-pressed={point.selected} aria-label={`${point.iteration === 0 ? 'Base harness' : `Iteration ${point.iteration}`}: ${point.terminal} of 80 terminal successes and ${point.matchedPoints} of 240 matched points.${point.selected ? ' Selected harness.' : ''}`}>
                <rect class="hit-area" x={x(point.iteration) - 26} y={chart.topTop} width="52" height={chart.bottomBottom - chart.topTop} />
                <circle class="terminal-dot" cx={x(point.iteration)} cy={terminalY(point.terminal)} r={point.selected ? 6.5 : 5} />
                <circle class="point-dot" cx={x(point.iteration)} cy={pointY(point.matchedPoints)} r={point.iteration === 7 ? 6.5 : 5} />
              </g>)}
            </g>

            <g class="x-axis" aria-hidden="true">
              <line x1={chart.left} x2={chart.right} y1={chart.bottomBottom} y2={chart.bottomBottom} />
              {search.map(point => <g><line x1={x(point.iteration)} x2={x(point.iteration)} y1={chart.bottomBottom} y2={chart.bottomBottom + 5} /><text x={x(point.iteration)} y={chart.bottomBottom + 21} text-anchor="middle">{point.iteration === 0 ? 'Base' : point.iteration}</text></g>)}
              <text class="axis-title" x={(chart.left + chart.right) / 2} y={chart.bottomBottom + 47} text-anchor="middle">harness evaluation</text>
            </g>
          </svg>
        </div>
      </div>

      <aside class="inspector" aria-live="polite">
        <header>
          <small data-inspector-kicker>ITERATION {selected.iteration} · HARNESS {selected.harnessNumber}</small>
          <strong data-inspector-title>{selected.annotation}</strong>
          <span data-selection-badge>selected harness</span>
        </header>
        <div class="primary-metrics">
          <div><span>terminal successes</span><strong data-terminal>{selected.terminal} / 80</strong><small>optimization reward</small></div>
          <div><span>matched points</span><strong data-points>{selected.matchedPoints} / 240</strong><small>post-hoc diagnostic</small></div>
        </div>
        <dl>
          <div><dt>best-of-4 points</dt><dd data-best-four>{selected.bestOfFour} / 60</dd></div>
          <div><dt>tasks reaching 3/3</dt><dd data-three>{selected.tasksAtThree} / 20</dd></div>
          <div><dt>selected?</dt><dd data-selected>yes · first maximum</dd></div>
        </dl>
        <p class="inspector-note" data-note>AHE retained the first harness to reach the maximum observed terminal reward.</p>
      </aside>
    </div>

    <section class="matrix-section" aria-labelledby="ipd-matrix-title">
      <header>
        <div><small>BEST RECOVERY ACROSS FOUR ROLLOUTS</small><strong id="ipd-matrix-title">How close each task came</strong></div>
        <div class="matrix-legend" aria-label="Point recovery legend"><span>0 / 3</span>{[0, 1, 2, 3].map(level => <i class={`level-${level}`}></i>)}<span>3 / 3</span></div>
      </header>
      <div class="matrix-scroll" tabindex="0" role="region" aria-label="Twenty tasks by eleven harness evaluations">
        <div class="matrix" style="--matrix-columns: 11">
          <span class="corner">task</span>
          {search.map(point => <span class:list={['column-label', { active: point.iteration === selected.iteration }]} data-matrix-column={point.iteration}>{point.iteration === 0 ? 'Base' : point.iteration}</span>)}
          {pointMatrix.map(task => <Fragment>
            <span class="task-label" title={task.id}>{task.label}</span>
            {task.values.map((value, iteration) => <i class:list={[`matrix-cell level-${value}`, { active: iteration === selected.iteration }]} data-matrix-column={iteration} title={`${task.label} · ${iteration === 0 ? 'Base' : `iteration ${iteration}`} · ${value}/3 points`} aria-label={`${task.label}, ${iteration === 0 ? 'Base harness' : `iteration ${iteration}`}: ${value} of 3 points`}></i>)}
          </Fragment>)}
        </div>
      </div>
      <p class="matrix-summary"><strong>{reachedOne}/20</strong> tasks reached ≥1 point <span>·</span> <strong>{reachedTwo}/20</strong> reached ≥2 <span>·</span> only <strong>{reachedThree}/20</strong> ever reached 3/3</p>
    </section>

    <div class="takeaway">For AHE, 0/3 and 2/3 were the same reward.</div>
    <figcaption><strong>The binary objective hides most of the progress made during search.</strong> AHE selected iteration 2 because it was the first harness to reach 2/80 terminal successes. Iteration 7 recovered substantially more individual interaction points, 43/240 versus 33/240, but received only 1/80 terminal successes. Across all 11 harness evaluations, terminal reward and partial-point recovery were only weakly correlated (Pearson <em>r</em> = {correlation.toFixed(2)}).</figcaption>
  </figure>
  <script is:inline type="application/json" class="ipd-search-data" set:html={JSON.stringify({ search })} />
</ipd-reward-gap>

<script>
  class IpdRewardGap extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const controller = new AbortController(); const { signal } = controller;
      const payload = JSON.parse(this.querySelector('.ipd-search-data')!.textContent!);
      const evaluations = [...this.querySelectorAll<SVGGElement>('[data-point]')];
      const matrixItems = [...this.querySelectorAll<HTMLElement>('[data-matrix-column]')];
      const fields = {
        kicker: this.querySelector<HTMLElement>('[data-inspector-kicker]')!,
        title: this.querySelector<HTMLElement>('[data-inspector-title]')!,
        badge: this.querySelector<HTMLElement>('[data-selection-badge]')!,
        terminal: this.querySelector<HTMLElement>('[data-terminal]')!,
        points: this.querySelector<HTMLElement>('[data-points]')!,
        bestFour: this.querySelector<HTMLElement>('[data-best-four]')!,
        three: this.querySelector<HTMLElement>('[data-three]')!,
        selected: this.querySelector<HTMLElement>('[data-selected]')!,
        note: this.querySelector<HTMLElement>('[data-note]')!,
      };
      const show = (iteration: number, focus = false) => {
        const point = payload.search[iteration]; this.dataset.activeIteration = String(iteration);
        evaluations.forEach((node, index) => { const active = index === iteration; node.classList.toggle('active', active); node.setAttribute('aria-pressed', String(active)); });
        matrixItems.forEach(item => item.classList.toggle('active', Number(item.dataset.matrixColumn) === iteration));
        fields.kicker.textContent = `${iteration === 0 ? 'BASE' : `ITERATION ${iteration}`} · HARNESS ${point.harnessNumber}`;
        fields.title.textContent = point.annotation;
        fields.badge.hidden = !point.selected;
        fields.terminal.textContent = `${point.terminal} / ${point.totalTrajectories}`;
        fields.points.textContent = `${point.matchedPoints} / ${point.possiblePoints}`;
        fields.bestFour.textContent = `${point.bestOfFour} / ${point.bestOfFourPossible}`;
        fields.three.textContent = `${point.tasksAtThree} / ${point.totalTasks}`;
        fields.selected.textContent = point.selected ? 'yes · first maximum' : 'no';
        fields.note.textContent = point.selected
          ? 'AHE retained the first harness to reach the maximum observed terminal reward.'
          : iteration === 5
            ? 'This harness tied the terminal maximum, but first-maximum selection retained iteration 2.'
            : iteration === 7
              ? 'This harness recovered the most individual points, but its lower terminal reward was visible to AHE.'
              : 'Matched-point recovery was computed afterward and was not available to the optimizer.';
        if (focus) evaluations[iteration].focus();
      };
      evaluations.forEach((evaluation, iteration) => {
        evaluation.addEventListener('pointerenter', () => show(iteration), { signal });
        evaluation.addEventListener('focus', () => show(iteration), { signal });
        evaluation.addEventListener('click', () => show(iteration, true), { signal });
        evaluation.addEventListener('keydown', event => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault(); show((iteration + (event.key === 'ArrowRight' ? 1 : -1) + evaluations.length) % evaluations.length, true);
        }, { signal });
      });
      this.cleanup = () => controller.abort();
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('ipd-reward-gap')) customElements.define('ipd-reward-gap', IpdRewardGap);
</script>

