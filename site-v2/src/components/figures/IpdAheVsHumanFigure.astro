  figure{margin:0}.figure-layout{display:grid;grid-template-columns:minmax(0,1fr) 276px;gap:24px;align-items:stretch}.chart-column{min-width:0}.chart-key{display:flex;align-items:center;flex-wrap:wrap;gap:8px 17px;min-height:24px;margin-bottom:4px;color:var(--color-ink-soft);font:9px/1.35 var(--font-mono)}.chart-key span{display:flex;align-items:center;gap:6px}.chart-key i{display:block;width:18px}.raw-key{border-top:2px solid var(--coral)}.best-key{border-top:1.5px dashed color-mix(in srgb,var(--coral) 68%,var(--color-ink))}.chart-key em{margin-left:auto;font-style:normal}.chart-scroll{overflow-x:auto;scrollbar-width:thin;scrollbar-color:var(--color-line) transparent}.search-chart{display:block;width:100%;min-width:760px;height:auto;overflow:visible}
  .panel-kicker{fill:var(--graphite);font:700 9px var(--font-mono);letter-spacing:.08em}.panel-kicker.coral{fill:var(--coral)}.panel-title{fill:var(--color-ink);font:600 11px var(--font-mono)}.diagnostic-label{fill:var(--color-ink-soft);font:8px var(--font-mono);letter-spacing:.045em}.grid line{stroke:var(--color-line);stroke-width:1}.grid text,.x-axis text{fill:var(--color-ink-soft);font:9px var(--font-mono)}.terminal-raw,.terminal-best,.point-raw{fill:none;vector-effect:non-scaling-stroke}.terminal-raw{stroke:color-mix(in srgb,var(--coral) 62%,transparent);stroke-width:1.4}.terminal-best{stroke:color-mix(in srgb,var(--coral) 72%,var(--color-ink));stroke-width:2;stroke-dasharray:6 4}.point-raw{stroke:var(--graphite);stroke-width:1.8}.milestone-guides line{vector-effect:non-scaling-stroke;stroke-width:1;stroke-dasharray:3 4}.selected-guide{stroke:color-mix(in srgb,var(--coral) 65%,transparent)}.peak-guide{stroke:color-mix(in srgb,var(--graphite) 55%,transparent)}.milestone-guides text{font:600 8px var(--font-mono);text-transform:uppercase}.selected-annotation text{fill:var(--coral)}.peak-annotation text{fill:var(--graphite)}
  .correlation line{stroke:var(--color-line)}.correlation rect{fill:var(--color-paper)}.correlation text{fill:var(--color-ink-soft);font:9px var(--font-mono)}.evaluation{cursor:pointer;outline:none}.hit-area{fill:transparent}.terminal-dot,.point-dot{fill:var(--color-paper);stroke-width:2;vector-effect:non-scaling-stroke;transition:r .15s,fill .15s}.terminal-dot{stroke:var(--coral)}.point-dot{stroke:var(--graphite)}.evaluation:hover .terminal-dot,.evaluation:focus .terminal-dot,.evaluation.active .terminal-dot{r:7.5px;fill:var(--coral)}.evaluation:hover .point-dot,.evaluation:focus .point-dot,.evaluation.active .point-dot{r:7.5px;fill:var(--graphite)}.evaluation:focus-visible .hit-area{stroke:var(--coral);stroke-width:1}.evaluation.selected .terminal-dot{fill:var(--coral);stroke:var(--color-paper);stroke-width:3}.x-axis line{stroke:var(--color-line)}.x-axis .axis-title{font-size:8px;letter-spacing:.05em;text-transform:uppercase}
  .inspector{display:flex;flex-direction:column;min-width:0;border:1px solid var(--color-line);background:color-mix(in srgb,var(--color-paper-raised) 62%,var(--color-paper))}.inspector>header{min-height:88px;padding:14px 15px 12px;border-bottom:1px solid var(--color-line)}.inspector>header small{display:block;color:var(--coral);font:700 9px/1.35 var(--font-mono);letter-spacing:.06em}.inspector>header strong{display:block;margin-top:6px;font:500 18px/1.25 var(--font-serif)}.inspector>header span{display:inline-block;margin-top:8px;padding:2px 6px;background:var(--coral-soft);color:var(--coral);font:700 8px/1.35 var(--font-mono);text-transform:uppercase}.primary-metrics{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--color-line)}.primary-metrics>div{padding:12px}.primary-metrics>div+div{border-left:1px solid var(--color-line)}.primary-metrics span,.primary-metrics small{display:block;color:var(--color-ink-soft);font:8px/1.35 var(--font-mono)}.primary-metrics strong{display:block;margin:5px 0 3px;font:600 17px/1.1 var(--font-mono)}.primary-metrics>div:first-child strong{color:var(--coral)}.primary-metrics>div:last-child strong{color:var(--graphite)}.inspector dl{margin:0}.inspector dl div{display:flex;justify-content:space-between;gap:12px;padding:9px 12px;border-bottom:1px solid var(--color-line)}.inspector dt{color:var(--color-ink-soft);font:9px/1.35 var(--font-mono)}.inspector dd{margin:0;font:600 9px/1.35 var(--font-mono);text-align:right}.inspector-note{margin:auto 0 0;padding:13px 14px;color:var(--color-ink-soft);font:10px/1.55 var(--font-sans)}[hidden]{display:none!important}
