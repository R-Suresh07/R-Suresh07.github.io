---
import FigureHeading from '../FigureHeading.astro';
import searchCsv from '../../content/writing/data/ipd_ahe_search.csv?raw';
import pointMatrixCsv from '../../content/writing/data/ipd_ahe_task_point_matrix.csv?raw';
import terminalMatrixCsv from '../../content/writing/data/ipd_ahe_task_terminal_matrix.csv?raw';

const parseCsv = (source: string) => {
  const [headerLine, ...lines] = source.trim().split(/\r?\n/);
  const headers = headerLine.split(',');
  return lines.filter(Boolean).map(line => {
    const values = line.split(',');
    return Object.fromEntries(headers.map((header, index) => [header, values[index] ?? '']));
  });
};

const harnessChanges = [
  {
    title: 'Base harness',
    explanation: 'The model received the receptor structure and pocket location, but no IPD-specific search procedure. It had to devise its own method for locating and labeling the three ligand-side interaction points.',
  },
  {
    title: 'Map the cavity and score hotspots',
    explanation: 'The harness maps the ligand-accessible cavity, scores locations for possible ligand interactions, and groups nearby high-scoring locations into hotspots. This turns an open-ended 3D search into a staged geometric workflow.',
  },
  {
    title: 'Simplify workflow and score points in bulk',
    explanation: 'The harness scores all cavity locations together using receptor-contact geometry and pocket burial. The shorter workflow is intended to reduce computation overhead and leave more time for comparing candidates.',
  },
  {
    title: 'Score complete three-point sets',
    explanation: 'Instead of selecting the best points one at a time, the harness evaluates complete three-point combinations. It favors sets whose points are well separated, remain inside the cavity, and form a compact arrangement near the pocket center.',
  },
  {
    title: 'Add structure probes and loosen geometry rules',
    explanation: 'The harness can test its geometric hotspots by predicting where small generic fragments might bind. It also allows points and the set center to lie farther from the supplied pocket center.',
  },
  {
    title: 'Anchor the search on hydrogen-bond sites',
    explanation: 'The harness constructs hydrogen-bond points directly from the position and direction of receptor donor or acceptor groups. It keeps only anchors that lie in accessible, sufficiently buried pocket space.',
  },
  {
    title: 'Search low-energy interaction sites',
    explanation: 'For hydrophobic and aromatic points, the harness searches for locations where a generic carbon probe would interact favorably with the pocket. Local low-energy regions become candidate hotspots.',
  },
  {
    title: 'Spread points across the cavity',
    explanation: 'The harness estimates the cavity’s main axis, divides that axis into sections, and selects a strong candidate from each section. This discourages all three predictions from clustering in one local hotspot.',
  },
  {
    title: 'Use sub-pocket centers with a cross-check',
    explanation: 'The harness groups high-scoring hydrophobic locations into sub-pockets and uses each group’s center as a candidate. It gives greater confidence to sites found by both contact-based scoring and the independent energy calculation.',
  },
  {
    title: 'Remove the cross-check',
    explanation: 'The harness stops requiring agreement between contact-based and energy-based scoring. This leaves more candidate sub-pockets available, but removes the independent confirmation used in Iteration 8.',
  },
  {
    title: 'Return to bulk grid scoring',
    explanation: 'The harness restores Iteration 2’s simpler recipe: score every cavity-grid location in bulk, cluster the strongest locations, and choose the final points from those clusters. It no longer uses the later precise-anchor or sub-pocket procedures.',
  },
] as const;

const search = parseCsv(searchCsv).map(row => ({
  iteration: Number(row.display_index),
  harnessNumber: Number(row.harness_number),
  selected: row.selected === 'true',
  terminal: Number(row.successful_trajectories),
  totalTrajectories: Number(row.total_trajectories),
  bestTerminal: Number(row.best_so_far_percent) * Number(row.total_trajectories) / 100,
  matchedPoints: Number(row.matched_points),
  possiblePoints: Number(row.possible_points),
  bestOfFour: Number(row.best_of_four_points),
  bestOfFourPossible: Number(row.best_of_four_possible_points),
  tasksAtOne: Number(row.tasks_with_at_least_1_point),
  tasksAtTwo: Number(row.tasks_with_at_least_2_points),
  tasksAtThree: Number(row.tasks_with_3_points),
  totalTasks: Number(row.total_tasks),
  annotation: row.annotation,
}));

const pointMatrix = parseCsv(pointMatrixCsv).map(row => ({
  id: row.task_id,
  label: row.label,
  values: search.map(point => Number(row[`iter${point.iteration}`])),
}));
const terminalMatrix = parseCsv(terminalMatrixCsv).map(row => ({
  id: row.task_id,
  values: search.map(point => Number(row[`iter${point.iteration}`])),
}));

const mean = (values: number[]) => values.reduce((sum, value) => sum + value, 0) / values.length;
const pearson = (left: number[], right: number[]) => {
  const leftMean = mean(left); const rightMean = mean(right);
  const numerator = left.reduce((sum, value, index) => sum + (value - leftMean) * (right[index] - rightMean), 0);
  const denominator = Math.sqrt(
    left.reduce((sum, value) => sum + (value - leftMean) ** 2, 0)
    * right.reduce((sum, value) => sum + (value - rightMean) ** 2, 0),
  );
  return numerator / denominator;
};

const selected = search.find(point => point.selected)!;
const partialPeak = search.reduce((best, point) => point.matchedPoints > best.matchedPoints ? point : best, search[0]);
const reachedOne = pointMatrix.filter(task => Math.max(...task.values) >= 1).length;
const reachedTwo = pointMatrix.filter(task => Math.max(...task.values) >= 2).length;
const reachedThree = pointMatrix.filter(task => Math.max(...task.values) >= 3).length;
const correlation = pearson(search.map(point => point.terminal), search.map(point => point.matchedPoints));

const dataMismatch = search.length !== 11 || harnessChanges.length !== search.length || pointMatrix.length !== 20 || terminalMatrix.length !== 20
  || search.some(point => point.totalTrajectories !== 80 || point.possiblePoints !== 240 || point.bestOfFourPossible !== 60 || point.totalTasks !== 20)
  || search.some(point => pointMatrix.reduce((sum, task) => sum + task.values[point.iteration], 0) !== point.bestOfFour)
  || search.some(point => pointMatrix.filter(task => task.values[point.iteration] >= 1).length !== point.tasksAtOne)
  || search.some(point => pointMatrix.filter(task => task.values[point.iteration] >= 2).length !== point.tasksAtTwo)
  || search.some(point => pointMatrix.filter(task => task.values[point.iteration] === 3).length !== point.tasksAtThree)
  || search.some(point => terminalMatrix.reduce((sum, task) => sum + task.values[point.iteration], 0) !== point.terminal)
  || search.some(point => terminalMatrix.filter(task => task.values[point.iteration] > 0).length !== point.tasksAtThree)
  || selected.iteration !== 2 || selected.terminal !== 2 || selected.matchedPoints !== 33
  || partialPeak.iteration !== 7 || partialPeak.terminal !== 1 || partialPeak.matchedPoints !== 43
  || reachedOne !== 20 || reachedTwo !== 17 || reachedThree !== 6
  || Math.round(correlation * 100) / 100 !== 0.29;
if (dataMismatch) throw new Error('FIG. 24: IPD AHE search data no longer matches its validated totals.');

const chart = { left: 76, right: 930 };
const topPlot = { top: 48, bottom: 205 };
const bottomPlot = { top: 48, bottom: 210 };
const terminalCeiling = 3.4;
const pointCeiling = 50;
const x = (iteration: number) => chart.left + iteration / 10 * (chart.right - chart.left);
const terminalY = (value: number) => topPlot.bottom - value / terminalCeiling * (topPlot.bottom - topPlot.top);
const pointY = (value: number) => bottomPlot.bottom - value / pointCeiling * (bottomPlot.bottom - bottomPlot.top);
const rawTerminalPath = search.map((point, index) => `${index ? 'L' : 'M'} ${x(point.iteration)} ${terminalY(point.terminal)}`).join(' ');
const bestTerminalPath = search.reduce((path, point, index) => {
  const pointX = x(point.iteration); const pointY = terminalY(point.bestTerminal);
  return index ? `${path} H ${pointX} V ${pointY}` : `M ${pointX} ${pointY}`;
}, '');
const matchedPointPath = search.map((point, index) => `${index ? 'L' : 'M'} ${x(point.iteration)} ${pointY(point.matchedPoints)}`).join(' ');
---

<ipd-reward-gap data-active-iteration={selected.iteration}>
  <figure aria-label="IPD automated harness search objective and hidden partial progress across 11 evaluations">
    <FigureHeading label="FIG. 24" title="AHE saw only the last step" subtitle="Interaction Point Discovery · 20 tasks · 4 rollouts per harness · optimized for terminal success" />

    <div class="rank-comparison" aria-label="The ranking inversion between iterations 2 and 7">
      <section class="selected-summary">
        <small>SELECTED BY AHE · ITERATION 2</small>
        <div><strong>2 / 80</strong><span>complete successes</span></div>
        <p><b>33 / 240</b> interaction points recovered</p>
      </section>
      <div class="ranking-rule" aria-hidden="true"><strong>2 complete successes &gt; 1</strong><span>AHE ranked iteration 2 higher</span></div>
      <section class="partial-summary">
        <small>BEST PARTIAL RECOVERY · ITERATION 7</small>
        <div><strong>1 / 80</strong><span>complete success</span></div>
        <p><b>43 / 240</b> interaction points recovered</p>
        <em>not visible to AHE</em>
      </section>
    </div>

    <div class="figure-layout">
      <div class="chart-column">
        <div class="chart-key" aria-label="Chart legend">
          <span><i class="raw-key"></i>observed terminal reward</span>
          <span><i class="best-key"></i>best so far</span>
          <em>select an evaluation</em>
        </div>
        <div class="chart-scroll" tabindex="0" role="region" aria-label="Two aligned IPD search curves; scroll horizontally on narrow screens">
          <div class="plot-panel terminal-panel">
            <svg class="search-chart" viewBox="0 0 1000 230" role="img" aria-label="Complete successes across eleven harness evaluations">
              <g class="panel-labels" aria-hidden="true"><text class="panel-kicker coral" x={chart.left} y="15">OPTIMIZATION REWARD</text><text class="panel-title" x={chart.left} y="32">complete successes / 80 trajectories</text></g>
              <g class="grid" aria-hidden="true">{[0, 1, 2, 3].map(tick => <g><line x1={chart.left} x2={chart.right} y1={terminalY(tick)} y2={terminalY(tick)} /><text x={chart.left - 14} y={terminalY(tick) + 4} text-anchor="end">{tick}</text></g>)}</g>
              <g class="milestone-guides" aria-hidden="true">
                <rect class="selected-band" x={x(2) - 25} y={topPlot.top} width="50" height={topPlot.bottom - topPlot.top} /><rect class="peak-band" x={x(7) - 25} y={topPlot.top} width="50" height={topPlot.bottom - topPlot.top} />
                <line class="selected-guide" x1={x(2)} x2={x(2)} y1={topPlot.top} y2={topPlot.bottom} /><line class="peak-guide" x1={x(7)} x2={x(7)} y1={topPlot.top} y2={topPlot.bottom} />
                <g class="selected-annotation"><text x={x(2) + 8} y={terminalY(2) - 28}>selected by AHE</text><text x={x(2) + 8} y={terminalY(2) - 15}>2 / 80 complete</text></g>
              </g>
              <path class="terminal-best" d={bestTerminalPath} /><path class="terminal-raw" d={rawTerminalPath} />
              <g class="evaluations">{search.map(point => <g class:list={['evaluation', { selected: point.selected, 'partial-peak': point.iteration === partialPeak.iteration }]} data-point={point.iteration} tabindex="0" role="button" aria-expanded="false" aria-controls="fig-24-inspector" aria-label={`${point.iteration === 0 ? 'Base harness' : `Iteration ${point.iteration}`}: ${point.terminal} of 80 complete successes`}><rect class="hit-area" x={x(point.iteration) - 26} y={topPlot.top} width="52" height={topPlot.bottom - topPlot.top} /><circle class="terminal-dot" cx={x(point.iteration)} cy={terminalY(point.terminal)} r={point.selected ? 6.5 : 5} /></g>)}</g>
            </svg>
          </div>

          <p class="correlation-note">Terminal reward tracked partial progress poorly · <em>r</em> = {correlation.toFixed(2)}</p>

          <div class="plot-panel partial-panel">
            <svg class="search-chart" viewBox="0 0 1000 265" role="img" aria-label="Interaction points recovered across eleven harness evaluations">
              <g class="panel-labels" aria-hidden="true"><text class="panel-kicker" x={chart.left} y="15">PARTIAL PROGRESS — HIDDEN FROM AHE</text><text class="panel-title" x={chart.left} y="32">interaction points recovered / 240</text><text class="diagnostic-label" x={chart.right} y="32" text-anchor="end">computed afterward · AHE never saw this signal</text></g>
              <g class="grid" aria-hidden="true">{[0, 15, 30, 45].map(tick => <g><line x1={chart.left} x2={chart.right} y1={pointY(tick)} y2={pointY(tick)} /><text x={chart.left - 14} y={pointY(tick) + 4} text-anchor="end">{tick}</text></g>)}</g>
              <g class="milestone-guides" aria-hidden="true">
                <rect class="selected-band" x={x(2) - 25} y={bottomPlot.top} width="50" height={bottomPlot.bottom - bottomPlot.top} /><rect class="peak-band" x={x(7) - 25} y={bottomPlot.top} width="50" height={bottomPlot.bottom - bottomPlot.top} />
                <line class="selected-guide" x1={x(2)} x2={x(2)} y1={bottomPlot.top} y2={bottomPlot.bottom} /><line class="peak-guide" x1={x(7)} x2={x(7)} y1={bottomPlot.top} y2={bottomPlot.bottom} />
                <g class="peak-annotation"><text x={x(7) + 8} y={bottomPlot.top + 72}>best partial recovery</text><text class="annotation-value" x={x(7) + 8} y={bottomPlot.top + 86}>43 / 240</text><text x={x(7) + 8} y={bottomPlot.top + 99}>not selected</text></g>
              </g>
              <path class="point-raw" d={matchedPointPath} />
              <g class="evaluations">{search.map(point => <g class:list={['evaluation', { selected: point.selected, 'partial-peak': point.iteration === partialPeak.iteration }]} data-point={point.iteration} tabindex="0" role="button" aria-expanded="false" aria-controls="fig-24-inspector" aria-label={`${point.iteration === 0 ? 'Base harness' : `Iteration ${point.iteration}`}: ${point.matchedPoints} of 240 interaction points recovered`}><rect class="hit-area" x={x(point.iteration) - 26} y={bottomPlot.top} width="52" height={bottomPlot.bottom - bottomPlot.top} /><circle class="point-dot" cx={x(point.iteration)} cy={pointY(point.matchedPoints)} r={point.iteration === 7 ? 6.5 : 5} /></g>)}</g>
              <g class="x-axis" aria-hidden="true"><line x1={chart.left} x2={chart.right} y1={bottomPlot.bottom} y2={bottomPlot.bottom} />{search.map(point => <g><line x1={x(point.iteration)} x2={x(point.iteration)} y1={bottomPlot.bottom} y2={bottomPlot.bottom + 5} /><text x={x(point.iteration)} y={bottomPlot.bottom + 21} text-anchor="middle">{point.iteration === 0 ? 'Base' : point.iteration}</text></g>)}<text class="axis-title" x={(chart.left + chart.right) / 2} y={bottomPlot.bottom + 46} text-anchor="middle">harness evaluation</text></g>
            </svg>
          </div>
        </div>
      </div>

      <button class="drawer-backdrop" type="button" hidden aria-label="Close iteration details"></button>
      <aside id="fig-24-inspector" class="inspector" hidden aria-live="polite" aria-label="Selected harness evaluation details">
        <header>
          <div class="inspector-heading">
            <small data-inspector-kicker>ITERATION {selected.iteration} · HARNESS {selected.harnessNumber}</small>
            <div class="inspector-title-row">
              <strong data-inspector-title>{harnessChanges[selected.iteration].title}</strong>
              <span class="change-help">
                <button class="change-help-trigger" type="button" aria-label="Explain this harness change" aria-expanded="false" aria-describedby="fig-24-change-help">?</button>
                <span id="fig-24-change-help" class="change-help-tooltip" role="tooltip" data-inspector-explanation>{harnessChanges[selected.iteration].explanation}</span>
              </span>
            </div>
          </div>
          <button class="drawer-close" type="button" aria-label="Close iteration details">×</button>
        </header>
        <div class="primary-metrics">
          <div><span>AHE reward</span><strong data-terminal>{selected.terminal} / 80</strong><small>complete successes</small></div>
          <div><span>hidden partial progress</span><strong data-points>{selected.matchedPoints} / 240</strong><small>interaction points recovered</small></div>
        </div>
        <dl>
          <div><dt>tasks fully solved</dt><dd data-three>{selected.tasksAtThree} / 20</dd></div>
          <div><dt>selection</dt><dd data-selected>Selected · first to reach 2 / 80</dd></div>
        </dl>
      </aside>
    </div>

    <div class="takeaway">For AHE, 0/3 and 2/3 were the same reward.</div>

    <details class="matrix-disclosure">
      <summary>See how close each task got <span aria-hidden="true">▾</span></summary>
      <section class="matrix-section" aria-labelledby="ipd-matrix-title">
        <header><strong id="ipd-matrix-title">How close each task got</strong><small>best result across four attempts · 0–3 interaction points recovered</small></header>
        <div class="matrix-scroll" tabindex="0" role="region" aria-label="Twenty tasks by eleven harness evaluations">
          <div class="matrix" style="--matrix-columns: 11">
            <span class="corner">task</span>
            {search.map(point => <span class:list={['column-label', { 'ahe-selected': point.selected, 'partial-best': point.iteration === partialPeak.iteration }]}>{point.iteration === 0 ? 'Base' : point.iteration}</span>)}
            {pointMatrix.map(task => <Fragment>
              <span class="task-label" title={task.id}>{task.label}</span>
              {task.values.map((value, iteration) => <i class={`matrix-cell level-${value}`} title={`${task.label} · ${iteration === 0 ? 'Base' : `iteration ${iteration}`} · ${value}/3 points`} aria-label={`${task.label}, ${iteration === 0 ? 'Base harness' : `iteration ${iteration}`}: ${value} of 3 points`}></i>)}
            </Fragment>)}
            <i class="column-outline selected-outline" style={`--column-index:${selected.iteration}`} aria-hidden="true"></i>
            <i class="column-outline partial-outline" style={`--column-index:${partialPeak.iteration}`} aria-hidden="true"></i>
          </div>
        </div>
        <p class="matrix-summary"><strong>{reachedOne}/20</strong> ever reached ≥1 <span>·</span> <strong>{reachedTwo}/20</strong> ever reached ≥2 <span>·</span> only <strong>{reachedThree}/20</strong> ever reached 3/3</p>
      </section>
    </details>
    <figcaption><strong>A terminal-only reward discarded most of the partial-progress signal generated during search.</strong> AHE selected iteration 2 because it was the first harness to achieve 2/80 complete successes. Iteration 7 recovered substantially more individual interaction points, 43/240 versus 33/240, but produced only 1/80 complete successes and was therefore ranked lower by the optimization objective. Across the search, terminal reward and partial recovery were only weakly correlated (Pearson <em>r</em> = {correlation.toFixed(2)}).</figcaption>
  </figure>
  <script is:inline type="application/json" class="ipd-search-data" set:html={JSON.stringify({ search, harnessChanges })} />
</ipd-reward-gap>

<script>
  class IpdRewardGap extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const controller = new AbortController(); const { signal } = controller;
      const payload = JSON.parse(this.querySelector('.ipd-search-data')!.textContent!);
      const evaluations = [...this.querySelectorAll<SVGGElement>('[data-point]')];
      const shell = this.querySelector<HTMLElement>('.figure-layout')!;
      const drawer = this.querySelector<HTMLElement>('.inspector')!;
      const backdrop = this.querySelector<HTMLButtonElement>('.drawer-backdrop')!;
      const close = this.querySelector<HTMLButtonElement>('.drawer-close')!;
      const help = this.querySelector<HTMLElement>('.change-help')!;
      const helpTrigger = this.querySelector<HTMLButtonElement>('.change-help-trigger')!;
      const fields = {
        kicker: this.querySelector<HTMLElement>('[data-inspector-kicker]')!,
        title: this.querySelector<HTMLElement>('[data-inspector-title]')!,
        explanation: this.querySelector<HTMLElement>('[data-inspector-explanation]')!,
        terminal: this.querySelector<HTMLElement>('[data-terminal]')!,
        points: this.querySelector<HTMLElement>('[data-points]')!,
        three: this.querySelector<HTMLElement>('[data-three]')!,
        selected: this.querySelector<HTMLElement>('[data-selected]')!,
      };
      let activeTrigger: SVGGElement | null = null;
      const setHelpOpen = (open: boolean) => {
        help.classList.toggle('open', open);
        helpTrigger.setAttribute('aria-expanded', String(open));
      };
      const openDrawer = (iteration: number, trigger: SVGGElement) => {
        const point = payload.search[iteration]; this.dataset.activeIteration = String(iteration);
        activeTrigger = trigger;
        evaluations.forEach(node => { const active = Number(node.dataset.point) === iteration; node.classList.toggle('active', active); node.setAttribute('aria-expanded', String(active)); });
        fields.kicker.textContent = `${iteration === 0 ? 'BASE' : `ITERATION ${iteration}`} · HARNESS ${point.harnessNumber}`;
        fields.title.textContent = payload.harnessChanges[iteration].title;
        fields.explanation.textContent = payload.harnessChanges[iteration].explanation;
        setHelpOpen(false);
        fields.terminal.textContent = `${point.terminal} / ${point.totalTrajectories}`;
        fields.points.textContent = `${point.matchedPoints} / ${point.possiblePoints}`;
        fields.three.textContent = `${point.tasksAtThree} / ${point.totalTasks}`;
        fields.selected.textContent = point.selected
          ? 'Selected · first to reach 2 / 80'
          : iteration === 5
            ? 'Not selected · tied after iteration 2'
            : `Not selected · ${point.terminal} / 80 reward`;
        drawer.hidden = false; backdrop.hidden = false; shell.classList.add('drawer-open'); close.focus();
      };
      const closeDrawer = () => {
        setHelpOpen(false);
        drawer.hidden = true; backdrop.hidden = true; shell.classList.remove('drawer-open');
        evaluations.forEach(node => { node.classList.remove('active'); node.setAttribute('aria-expanded', 'false'); });
        activeTrigger?.focus(); activeTrigger = null;
      };
      evaluations.forEach(evaluation => {
        const iteration = Number(evaluation.dataset.point);
        evaluation.addEventListener('click', () => openDrawer(iteration, evaluation), { signal });
        evaluation.addEventListener('keydown', event => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault(); const siblings = [...evaluation.closest('.plot-panel')!.querySelectorAll<SVGGElement>('[data-point]')]; const current = siblings.indexOf(evaluation); siblings[(current + (event.key === 'ArrowRight' ? 1 : -1) + siblings.length) % siblings.length].focus();
        }, { signal });
      });
      helpTrigger.addEventListener('focus', () => setHelpOpen(true), { signal });
      helpTrigger.addEventListener('blur', () => setHelpOpen(false), { signal });
      helpTrigger.addEventListener('click', event => {
        event.stopPropagation();
        setHelpOpen(true);
      }, { signal });
      this.addEventListener('click', event => {
        if (!help.contains(event.target as Node)) setHelpOpen(false);
      }, { signal });
      close.addEventListener('click', closeDrawer, { signal }); backdrop.addEventListener('click', closeDrawer, { signal });
      this.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        if (help.classList.contains('open')) { setHelpOpen(false); helpTrigger.focus(); return; }
        if (!drawer.hidden) closeDrawer();
      }, { signal });
      this.cleanup = () => controller.abort();
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('ipd-reward-gap')) customElements.define('ipd-reward-gap', IpdRewardGap);
</script>

<style>
  ipd-reward-gap{--coral:#a55a3e;--coral-soft:#eadbd3;--graphite:#555653;--graphite-soft:#d9d9d4;--teal:#087c83;display:block;width:min(var(--wide-width),var(--breakout-max-width,calc(100vw - 2 * var(--page-gutter))));max-width:calc(100vw - 2 * var(--page-gutter));box-sizing:border-box;margin:var(--space-6) 0;margin-inline:50%;transform:translateX(-50%);color:var(--color-ink);font:14px/1.5 var(--font-sans)}
