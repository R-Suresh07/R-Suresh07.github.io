---
import FigureHeading from '../FigureHeading.astro';

interface Props { label?: string; }
const { label = 'FIG. 15' } = Astro.props;

type OutcomeCategory = {
  key: string;
  label: string;
  count: number;
  description: string;
  start?: number;
};

const original: OutcomeCategory[] = [
  {
    key: 'pass',
    label: 'verified pass',
    count: 13,
    description: 'The submitted molecule passed every required gate under the official evaluator.',
  },
  {
    key: 'submitted-failure',
    label: 'submitted but failed',
    count: 53,
    description: 'The agent submitted a molecule that failed evaluation. V1 did not retain enough structured state to separate known failures from missing evidence.',
  },
  {
    key: 'turn-limit',
    label: 'turn limit',
    count: 2,
    description: 'The run reached its turn limit without producing a submission.',
  },
];

const structured: OutcomeCategory[] = [
  {
    key: 'pass',
    label: 'verified pass',
    count: 33,
    description: 'The exact registered candidate had complete evidence and passed every required gate.',
  },
  {
    key: 'known-failure',
    label: 'forced · known failed gate',
    count: 9,
    description: 'The harness knew at least one required gate was failing. The model explicitly chose to submit anyway.',
  },
  {
    key: 'missing-evidence',
    label: 'forced · missing evidence',
    count: 6,
    description: 'Six submissions had no known failure but were missing at least one required measurement.',
  },
  {
    key: 'turn-limit',
    label: 'turn limit',
    count: 20,
    description: 'The run reached its turn limit before the agent submitted a candidate.',
  },
];

const withStarts = (categories: OutcomeCategory[]) => {
  let start = 0;
  return categories.map(category => {
    const positioned = { ...category, start };
    start += category.count;
    return positioned;
  });
};

const harnesses = [
  { key: 'v1', name: 'Original harness', version: 'V1', categories: withStarts(original) },
  { key: 'v2', name: 'Redesigned harness', version: 'V2', categories: withStarts(structured) },
];

const resources = [
  { key: 'turns', label: 'Turns', v1: 5116, v2: 4496, v1Label: '5,116', v2Label: '4,496', delta: '−12%' },
  { key: 'tokens', label: 'Tokens', v1: 211.9, v2: 157.5, v1Label: '211.9M', v2Label: '157.5M', delta: '−26%' },
  { key: 'admet', label: 'ADMET calls', v1: 711, v2: 590, v1Label: '711', v2Label: '590', delta: '−17%' },
  { key: 'boltz', label: 'Boltz calls', v1: 170, v2: 257, v1Label: '170', v2Label: '257', delta: '+51%', increase: true },
].map(metric => ({ ...metric, max: Math.max(metric.v1, metric.v2) }));

if (original.reduce((sum, category) => sum + category.count, 0) !== 68
  || structured.reduce((sum, category) => sum + category.count, 0) !== 68) {
  throw new Error('LO outcome figure: each harness must account for exactly 68 tasks.');
}
---

<lo-harness-outcomes id="fig-15" data-view="outcome">
  <figure aria-label="Lead Optimization outcomes and resource use under the original and structured harnesses">
    <FigureHeading label={label} title="The agent submitted less and solved more" subtitle="Qwen 3.5 9B · same 68 tasks" />

    <div class="view-tabs" role="tablist" aria-label="Figure view">
      <button id="lo-outcome-tab" type="button" role="tab" aria-selected="true" aria-controls="lo-outcome-panel" tabindex="0" data-view="outcome">Outcome</button>
      <span aria-hidden="true">|</span>
      <button id="lo-resources-tab" type="button" role="tab" aria-selected="false" aria-controls="lo-resources-panel" tabindex="-1" data-view="resources">Resource use</button>
    </div>

    <section id="lo-outcome-panel" class="view-panel outcome-panel" role="tabpanel" aria-labelledby="lo-outcome-tab" data-panel="outcome">
      <div class="summary-grid" aria-label="Summary comparison">
        <article>
          <small>V1 <i>→</i> V2</small>
          <p><span>13</span><i>→</i><strong>33</strong><b>/ 68</b></p>
          <h3><span>tasks solved</span><em>19.1% → 48.5%</em></h3>
        </article>
        <article>
          <small>V1 <i>→</i> V2</small>
          <p><span>66</span><i>→</i><strong>48</strong></p>
          <h3><span>terminal submissions</span><em>97.1% → 70.6%</em></h3>
        </article>
        <article>
          <small>V1 <i>→</i> V2</small>
          <p><span>19.7%</span><i>→</i><strong>68.8%</strong></p>
          <h3>success among submissions</h3>
        </article>
      </div>

      <div class="outcome-chart">
        <p class="unit-note">one cell = one task · hover, tap, or focus a category</p>
        {harnesses.map(harness => <section class="harness-row" data-harness={harness.key}>
          <header>
            <div><b>{harness.version}</b><strong>{harness.name}</strong></div>
            <span>68 tasks</span>
          </header>
          <div class="strip-wrap">
            <div class="task-strip" aria-hidden="true">
              {harness.categories.flatMap(category => Array.from({ length: category.count }, () => <i class={`task-cell ${category.key}`} data-category={category.key} />))}
            </div>
            <div class="segment-hits">
              {harness.categories.map(category => <button
                type="button"
                class="segment-hit"
                style={`--start:${category.start};--count:${category.count}`}
                data-category={category.key}
                data-label={category.label}
                data-count={category.count}
                data-description={category.description}
                aria-label={`${harness.version}: ${category.count} ${category.label}. ${category.description}`}
              />)}
            </div>
          </div>
          <div class="category-list" aria-label={`${harness.version} outcome categories`}>
            {harness.categories.map(category => <button
              type="button"
              data-category={category.key}
              data-label={category.label}
              data-count={category.count}
              data-description={category.description}
            ><i class={`swatch ${category.key}`} aria-hidden="true" /><span>{category.label}</span><b>{category.count}</b></button>)}
          </div>
        </section>)}
      </div>

      <div class="category-explainer" aria-live="polite">
        <span class="explainer-label">Outcome categories</span>
        <p class="explainer-copy">V1 records the final result; V2 also records why a submission was allowed or forced.</p>
      </div>
    </section>

    <section id="lo-resources-panel" class="view-panel resources-panel" role="tabpanel" aria-labelledby="lo-resources-tab" data-panel="resources" hidden>
      <div class="resource-key" aria-hidden="true"><span><i class="v1-key" />V1 · original</span><span><i class="v2-key" />V2 · structured</span></div>
      <div class="resource-chart">
        {resources.map(metric => <article class:list={['resource-row', { increase: metric.increase }]}>
          <header>
            <h3>{metric.label}</h3>
            <div class="resource-values"><span>{metric.v1Label}</span><i>→</i><strong>{metric.v2Label}</strong><b>{metric.delta}</b></div>
          </header>
          <div class="paired-bars" aria-label={`${metric.label}: V1 ${metric.v1Label}; V2 ${metric.v2Label}; change ${metric.delta}`}>
            <div class="bar-track"><i class="v1-bar" style={`width:${metric.v1 / metric.max * 100}%`} /></div>
            <div class="bar-track"><i class="v2-bar" style={`width:${metric.v2 / metric.max * 100}%`} /></div>
          </div>
        </article>)}
      </div>
      <p class="resource-takeaway"><strong>More tasks were solved with fewer turns and tokens, even as the agent spent more of its budget on expensive structure checks.</strong></p>
    </section>

    <figcaption>
      <span data-caption="outcome"><strong>The structured harness changed both what the agent submitted and what the system knew about those submissions.</strong> On the same 68 Lead Optimization tasks, Qwen 3.5 9B solved substantially more tasks while making fewer terminal submissions. Unlike V1, V2 distinguishes verified successes, explicit forced submissions with known failed gates, and submissions made with incomplete evidence.</span>
      <span data-caption="resources" hidden><strong>The improvement did not come from simply spending more everywhere.</strong> Across the same 68 tasks, V2 used fewer turns, tokens, and ADMET calls, while increasing Boltz use by 51%.</span>
    </figcaption>
  </figure>
</lo-harness-outcomes>

<script>
  class LoHarnessOutcomes extends HTMLElement {
    cleanup?: () => void;

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const controller = new AbortController();
      const { signal } = controller;
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...this.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      const captions = [...this.querySelectorAll<HTMLElement>('[data-caption]')];
      const rows = [...this.querySelectorAll<HTMLElement>('.harness-row')];
      const explainerLabel = this.querySelector<HTMLElement>('.explainer-label')!;
      const explainerCopy = this.querySelector<HTMLElement>('.explainer-copy')!;
      const defaultLabel = explainerLabel.textContent!;
      const defaultCopy = explainerCopy.textContent!;
      let pinned: HTMLButtonElement | null = null;

      const setView = (view: string, focus = false) => {
        this.dataset.view = view;
        tabs.forEach(tab => {
          const active = tab.dataset.view === view;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          if (active && focus) tab.focus();
        });
        panels.forEach(panel => { panel.hidden = panel.dataset.panel !== view; });
        captions.forEach(caption => { caption.hidden = caption.dataset.caption !== view; });
      };

      const clearCategory = () => {
        rows.forEach(row => delete row.dataset.activeCategory);
        explainerLabel.textContent = defaultLabel;
        explainerCopy.textContent = defaultCopy;
      };

      const showCategory = (button: HTMLButtonElement) => {
        const row = button.closest<HTMLElement>('.harness-row')!;
        rows.forEach(other => delete other.dataset.activeCategory);
        row.dataset.activeCategory = button.dataset.category!;
        explainerLabel.textContent = `${button.dataset.count} · ${button.dataset.label}`;
        explainerCopy.textContent = button.dataset.description!;
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => setView(tab.dataset.view!), { signal });
        tab.addEventListener('keydown', event => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          const offset = event.key === 'ArrowRight' ? 1 : -1;
          setView(tabs[(index + offset + tabs.length) % tabs.length].dataset.view!, true);
        }, { signal });
      });

      this.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(button => {
        button.addEventListener('pointerenter', () => showCategory(button), { signal });
        button.addEventListener('focus', () => showCategory(button), { signal });
        button.addEventListener('pointerleave', () => { if (pinned) showCategory(pinned); else clearCategory(); }, { signal });
        button.addEventListener('blur', () => { if (pinned) showCategory(pinned); else clearCategory(); }, { signal });
        button.addEventListener('click', () => {
          pinned = pinned === button ? null : button;
          if (pinned) showCategory(button); else clearCategory();
        }, { signal });
      });

      this.cleanup = () => controller.abort();
    }

    disconnectedCallback() { this.cleanup?.(); }
  }

  if (!customElements.get('lo-harness-outcomes')) customElements.define('lo-harness-outcomes', LoHarnessOutcomes);
</script>

<style>
  lo-harness-outcomes {
    --accent:#087c83;
    --accent-soft:#d8ebe8;
    --failure:#a24e35;
    --failure-soft:#d9a28e;
    --missing:#c9983f;
    --timeout:#b7b4ab;
    display:block;
    width:min(var(--wide-width), var(--breakout-max-width, calc(100vw - 2 * var(--page-gutter))));
    max-width:calc(100vw - 2 * var(--page-gutter));
    box-sizing:border-box;
    margin:var(--space-6) 0;
    margin-inline:50%;
    transform:translateX(-50%);
    color:var(--color-ink);
    font:14px/1.5 var(--font-sans);
  }
  figure { margin:0; }
  button { color:inherit; font:inherit; }
  .view-tabs { display:flex; align-items:center; justify-content:flex-end; gap:10px; margin:-13px 0 25px; color:var(--color-line); font:13px/1.4 var(--font-mono); }
  .view-tabs button { padding:2px 0; border:0; border-bottom:1px solid transparent; background:none; color:var(--color-ink-soft); cursor:pointer; }
  .view-tabs button[aria-selected="true"] { border-bottom-color:var(--accent); color:var(--accent); }
  .view-tabs button:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
  .view-panel[hidden] { display:none; }

  .summary-grid { display:grid; grid-template-columns:repeat(3,1fr); border:1px solid var(--color-line); }
  .summary-grid article { padding:18px 20px 17px; border-left:1px solid var(--color-line); }
  .summary-grid article:first-child { border-left:0; }
  .summary-grid small { color:var(--color-ink-soft); font:12px/1.4 var(--font-mono); letter-spacing:.06em; text-transform:uppercase; }
  .summary-grid small i { color:var(--accent); font-style:normal; }
  .summary-grid p { display:flex; align-items:baseline; gap:9px; margin:11px 0 3px; font:32px/1 var(--font-serif); white-space:nowrap; }
  .summary-grid p span { color:var(--color-ink-soft); }
  .summary-grid p i { color:#aaa69c; font:15px/1 var(--font-mono); font-style:normal; }
  .summary-grid p strong { color:var(--accent); font-weight:500; }
  .summary-grid p b { margin-left:-6px; color:var(--color-ink-soft); font:12px/1 var(--font-mono); font-weight:400; }
  .summary-grid h3 { margin:8px 0 0; color:var(--color-ink-soft); font:13px/1.45 var(--font-mono); font-weight:400; }
  .summary-grid h3 em { display:block; margin-top:3px; color:var(--accent); font-style:normal; }

  .outcome-chart { margin-top:30px; }
  .unit-note { margin:0 0 13px; color:var(--color-ink-soft); font:12px/1.4 var(--font-mono); text-align:right; }
  .harness-row + .harness-row { margin-top:30px; }
  .harness-row header { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:9px; }
  .harness-row header div { display:flex; align-items:baseline; gap:10px; }
  .harness-row header b { color:var(--accent); font:13px/1.4 var(--font-mono); font-weight:600; }
  .harness-row header strong { font:19px/1.3 var(--font-serif); font-weight:500; }
  .harness-row header > span { color:var(--color-ink-soft); font:12px/1.4 var(--font-mono); }
  .strip-wrap { position:relative; }
  .task-strip { display:grid; grid-template-columns:repeat(68,minmax(0,1fr)); gap:2px; height:29px; }
  .task-cell { display:block; min-width:0; background:var(--timeout); transition:opacity .14s ease, transform .14s ease; }
  .task-cell.pass { background:var(--accent); }
  .task-cell.submitted-failure { background:var(--failure-soft); }
  .task-cell.known-failure { background:var(--failure); }
  .task-cell.missing-evidence { background:repeating-linear-gradient(135deg,var(--missing) 0 3px,color-mix(in srgb,var(--missing) 35%,var(--color-paper)) 3px 6px); }
  .task-cell.turn-limit { background:color-mix(in srgb,var(--timeout) 65%,var(--color-paper)); }
  .segment-hits { position:absolute; inset:0; }
  .segment-hit { position:absolute; top:0; bottom:0; left:calc(var(--start) / 68 * 100%); width:calc(var(--count) / 68 * 100%); padding:0; border:0; background:transparent; cursor:pointer; }
  .segment-hit:focus-visible { z-index:2; outline:2px solid var(--color-ink); outline-offset:3px; }
  .harness-row[data-active-category] .task-cell { opacity:.25; transform:scaleY(.78); }
  .harness-row[data-active-category="pass"] .task-cell.pass,
  .harness-row[data-active-category="submitted-failure"] .task-cell.submitted-failure,
  .harness-row[data-active-category="known-failure"] .task-cell.known-failure,
  .harness-row[data-active-category="missing-evidence"] .task-cell.missing-evidence,
  .harness-row[data-active-category="turn-limit"] .task-cell.turn-limit { opacity:1; transform:scaleY(1); }
  .category-list { display:flex; flex-wrap:wrap; gap:6px 17px; margin-top:9px; }
  .category-list button { display:flex; align-items:center; gap:7px; padding:0; border:0; background:none; color:var(--color-ink-soft); font:12px/1.45 var(--font-mono); cursor:pointer; }
  .category-list button:hover, .category-list button:focus-visible { color:var(--color-ink); }
  .category-list button:focus-visible { outline:1px solid var(--accent); outline-offset:3px; }
  .category-list button b { color:var(--color-ink); font-weight:600; }
  .swatch { width:10px; height:10px; background:var(--timeout); }
  .swatch.pass { background:var(--accent); }
  .swatch.submitted-failure { background:var(--failure-soft); }
  .swatch.known-failure { background:var(--failure); }
  .swatch.missing-evidence { background:repeating-linear-gradient(135deg,var(--missing) 0 2px,color-mix(in srgb,var(--missing) 30%,var(--color-paper)) 2px 4px); }
  .swatch.turn-limit { background:color-mix(in srgb,var(--timeout) 65%,var(--color-paper)); }
  .category-explainer { display:grid; grid-template-columns:150px 1fr; gap:20px; min-height:44px; padding:12px 14px; margin-top:26px; border-top:1px solid var(--color-line); border-bottom:1px solid var(--color-line); }
  .category-explainer span { color:var(--accent); font:12px/1.5 var(--font-mono); text-transform:uppercase; }
  .category-explainer p { margin:0; color:var(--color-ink-soft); font:12px/1.55 var(--font-sans); }

  .resources-panel { padding-top:4px; }
  .resource-key { display:flex; justify-content:flex-end; gap:20px; margin-bottom:16px; color:var(--color-ink-soft); font:12px/1.4 var(--font-mono); }
  .resource-key span { display:flex; align-items:center; gap:6px; }
  .resource-key i { width:13px; border-top:3px solid var(--timeout); }
  .resource-key .v2-key { border-color:var(--accent); }
  .resource-chart { border-top:1px solid var(--color-line); }
  .resource-row { display:grid; grid-template-columns:245px 1fr; align-items:center; gap:32px; padding:18px 0; border-bottom:1px solid var(--color-line); }
  .resource-row header { display:grid; grid-template-columns:90px 1fr; align-items:baseline; gap:12px; }
  .resource-row h3 { margin:0; font:17px/1.3 var(--font-serif); font-weight:500; }
  .resource-values { display:grid; grid-template-columns:1fr auto 1fr; align-items:baseline; gap:7px; font:12px/1.4 var(--font-mono); }
  .resource-values span { color:var(--color-ink-soft); text-align:right; }
  .resource-values i { color:#aaa69c; font-style:normal; }
  .resource-values strong { color:var(--accent); font-weight:600; }
  .resource-values b { grid-column:3; color:var(--accent); font-size:12px; font-weight:600; }
  .paired-bars { display:grid; gap:7px; }
  .bar-track { height:6px; background:color-mix(in srgb,var(--color-line) 26%,transparent); }
  .bar-track i { display:block; height:100%; }
  .v1-bar { background:var(--timeout); }
  .v2-bar { background:var(--accent); }
  .resource-row.increase .v2-bar { background:var(--failure); }
  .resource-row.increase .resource-values strong, .resource-row.increase .resource-values b { color:var(--failure); }
  .resource-takeaway { padding:20px 0 0; margin:0; font:16px/1.55 var(--font-serif); }
  .resource-takeaway strong { font-weight:500; }
  figcaption { margin:25px 0 0; color:var(--color-ink-soft); font:14px/1.8 var(--font-sans); }
  figcaption strong { color:var(--color-ink); font-weight:600; }

  @media (max-width:700px) {
    .summary-grid { grid-template-columns:1fr; }
    .summary-grid article { display:grid; grid-template-columns:1fr auto; align-items:end; padding:13px 15px; border-top:1px solid var(--color-line); border-left:0; }
    .summary-grid article:first-child { border-top:0; }
    .summary-grid small { grid-column:1; }
    .summary-grid p { grid-row:1 / 3; grid-column:2; margin:0 0 1px 15px; font-size:27px; }
    .summary-grid h3 { grid-column:1; }
    .task-strip { gap:1px; height:25px; }
    .category-explainer { grid-template-columns:1fr; gap:5px; }
    .resource-row { grid-template-columns:1fr; gap:12px; }
    .resource-row header { grid-template-columns:110px 1fr; }
  }
  @media (max-width:460px) {
    .view-tabs { justify-content:flex-start; }
    .summary-grid p { font-size:24px; gap:6px; }
    .summary-grid p i { font-size:12px; }
    .unit-note { text-align:left; }
    .category-list { gap:6px 12px; }
    .resource-key { justify-content:flex-start; }
  }
  @media (prefers-reduced-motion:reduce) {
    .task-cell { transition:none; }
  }
</style>
