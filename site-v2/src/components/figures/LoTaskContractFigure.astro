---
import FigureHeading from '../FigureHeading.astro';
import FigureCaption from '../FigureCaption.astro';
import { contract, layout, format } from './data/loTaskContract';
import reference from '../../assets/figures/lo-task-contract/c000.svg';
import nearMiss from '../../assets/figures/lo-task-contract/c002.svg';
import passing from '../../assets/figures/lo-task-contract/c004.svg';
const images = [reference, nearMiss, passing];
const initial = contract.states[0];
const groups = ['Must improve', 'Must stay in range', 'Must still pass'];
---

<lo-task-contract id="fig-10" data-stage="0" data-mode="values">
  <figure aria-label="A2A Lead Optimization task contract across three molecules">
    <FigureHeading label="FIG. 10" title="Lead Optimization moves one property while keeping the rest in range" />
    <p class="context">Adenosine A2A receptor <span>·</span> one target property, several requirements</p>
    <nav class="selector" aria-label="Select molecule">
      {contract.states.map((s,i) => <button type="button" data-stage-button={i} aria-pressed={i===0}>
        <i aria-hidden="true"></i><span>{s.label}</span><small>{s.id}{i === 1 ? ' · near miss' : i === 2 ? ' · passing' : ''}</small>
      </button>)}
    </nav>
    <div class="contract-body">
      <section class="molecule-panel" aria-label="Selected molecule">
        <header><span class="eyebrow" data-molecule-id>C000</span><h3 data-role>Starting molecule</h3></header>
        <div class="molecule-stage">
          {contract.states.map((s,i) => <img src={images[i].src} data-molecule={i} class:list={{active:i===0}} aria-hidden={i!==0} alt={`${s.id}, ${s.edit}`} width="520" height="330" loading="eager" />)}
        </div>
        <p class="edit" data-edit>{initial.edit}</p>
        <div class="state-message" aria-live="polite" aria-atomic="true">
          <strong data-status>{initial.status}</strong>
          <p data-summary>{initial.summary}</p>
        </div>
      </section>
      <section class="task-panel" aria-label="Evaluator requirements">
        <header class="contract-heading"><h3>Task contract</h3><div class="mode-control" role="group" aria-label="Display gate values or margins">
          <button type="button" data-mode-button="values" aria-pressed="true">Values</button>
          <button type="button" data-mode-button="margins" aria-pressed="false">Margins</button>
        </div></header>
        <p class="track-key"><i></i>Allowed region <span>· hover or tap for details</span></p>
        {groups.map(group => <section class="gate-group" aria-label={group}>
          <h4>{group}</h4>
          {contract.gates.filter(g => g.group === group).map(g => {
            const m = layout(initial,g,'values');
            return <div class="gate" data-gate={g.key} data-tone={m.tone}>
              <button class="gate-button" type="button" aria-expanded="false" aria-controls={`lo-contract-tip-${g.key}`} aria-label={m.detail}>
                <span class="gate-top"><span class="gate-name">{g.label}</span><strong data-reading>{m.display}</strong><span class="gate-icon" data-icon aria-hidden="true">{m.tone === 'unknown' ? '—' : m.tone === 'fail' ? '×' : '✓'}</span></span>
                <span class="gate-bottom"><span class="rule">{g.rule}</span><span class="track" aria-hidden="true">
                  <i class="allowed" style={`left:${m.start}%;width:${m.end-m.start}%`}></i>
                  <i class="boundary low" style={`left:${m.start}%`} hidden={!m.lowBoundary}></i>
                  <i class="boundary high" style={`left:${m.end}%`} hidden={!m.highBoundary}></i>
                  <b class="marker" style={`left:${m.point}%`} hidden={m.value === null}></b>
                </span></span>
              </button>
              <div class="gate-tip" id={`lo-contract-tip-${g.key}`}>
                <strong>{g.label}</strong>
                <dl><div><dt>Value</dt><dd data-tip-value>{m.value === null ? 'Not evaluated' : format(m.value)}</dd></div>
                  <div><dt>Required</dt><dd>{g.key === 'affinity' ? '≤ −0.41927987039089204' : g.rule}</dd></div>
                  <div><dt>Margin</dt><dd data-tip-margin>{m.margin === null ? '—' : format(m.margin,true)}</dd></div>
                </dl>
                <p data-tip-status>{g.key === 'affinity' ? 'Pass, reference baseline' : m.status}</p>
              </div>
            </div>;
          })}
          {group === 'Must still pass' && <details class="hard-constraints">
            <summary><span>Hard chemistry constraints</span><strong>All pass <span aria-hidden="true">✓</span></strong></summary>
            <table><thead><tr><th scope="col">Check</th><th scope="col">Required</th><th scope="col">Value</th></tr></thead>
              <tbody>{contract.chemistry.map(c => <tr><th scope="row">{c.label}</th><td>{c.rule}</td><td data-chemistry={c.key}>{initial.chemistry[c.key as keyof typeof initial.chemistry]}</td></tr>)}</tbody>
            </table>
          </details>}
        </section>)}
        <p class="scale-note" data-mode-note>Each track uses its own property scale.</p>
      </section>
    </div>
    <p class="takeaway">Lead Optimization succeeds only when the target improves and every other requirement still passes.</p>
    <FigureCaption captionLead="Lead Optimization is constrained editing.">
      In this A2A receptor task, the molecule must reduce predicted CYP3A4 while preserving hERG, BBB, solubility, binding affinity, molecular similarity, and the remaining chemistry constraints. Shortening both N-alkyl groups fixes CYP3A4 but pushes affinity outside its allowed range. Replacing the para-methyl group with fluorine passes every gate, although BBB remains only <strong class="caption-emphasis">0.0025</strong> inside its upper bound.
    </FigureCaption>
  </figure>
</lo-task-contract>

<script>
  import { contract, layout, format, type Mode } from './data/loTaskContract';
  class LoTaskContract extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const controller = new AbortController();
      const { signal } = controller;
      let stage = 0;
      let mode:Mode = 'values';
      const setText = (selector:string, value:string) => { this.querySelector(selector)!.textContent = value; };
      const closeTips = () => this.querySelectorAll<HTMLElement>('.gate').forEach(row => {
        row.classList.remove('pinned');
        row.querySelector('button')!.setAttribute('aria-expanded','false');
      });
      const render = () => {
        const state = contract.states[stage];
        this.dataset.stage = String(stage);
        this.dataset.mode = mode;
        this.querySelectorAll<HTMLButtonElement>('[data-stage-button]').forEach(b => b.setAttribute('aria-pressed',String(Number(b.dataset.stageButton)===stage)));
        this.querySelectorAll<HTMLButtonElement>('[data-mode-button]').forEach(b => b.setAttribute('aria-pressed',String(b.dataset.modeButton===mode)));
        this.querySelectorAll<HTMLElement>('[data-molecule]').forEach(img => {
          const active = Number(img.dataset.molecule)===stage;
          img.classList.toggle('active',active);
          img.setAttribute('aria-hidden',String(!active));
        });
        setText('[data-molecule-id]',state.id);
        setText('[data-role]',state.role);
        setText('[data-edit]',state.edit);
        setText('[data-status]',state.status);
        setText('[data-summary]',state.summary);
        setText('[data-mode-note]',mode === 'values' ? 'Each track uses its own property scale.' : 'Positive margin passes. Each row uses its own units.');
        contract.gates.forEach(g => {
          const m = layout(state,g,mode);
          const row = this.querySelector<HTMLElement>(`[data-gate="${g.key}"]`)!;
          row.dataset.tone = m.tone;
          row.querySelector('button')!.setAttribute('aria-label',m.detail);
          row.querySelector('[data-reading]')!.textContent = m.display;
          row.querySelector('[data-icon]')!.textContent = m.tone === 'unknown' ? '—' : m.tone === 'fail' ? '×' : m.tone === 'narrow' ? '✓ ·' : '✓';
          const marker = row.querySelector<HTMLElement>('.marker')!;
          marker.hidden = m.value === null;
          marker.style.left = `${m.point}%`;
          const allowed = row.querySelector<HTMLElement>('.allowed')!;
          allowed.style.left = `${m.start}%`;
          allowed.style.width = `${m.end-m.start}%`;
          const low = row.querySelector<HTMLElement>('.low')!;
          const high = row.querySelector<HTMLElement>('.high')!;
          low.hidden = !m.lowBoundary;
          high.hidden = !m.highBoundary;
          low.style.left = `${m.start}%`;
          high.style.left = `${m.end}%`;
          row.querySelector('.rule')!.textContent = mode === 'values' ? g.rule : g.strict ? 'margin > 0' : 'margin ≥ 0';
          row.querySelector('[data-tip-value]')!.textContent = m.value === null ? 'Not evaluated' : format(m.value);
          row.querySelector('[data-tip-margin]')!.textContent = m.margin === null ? '—' : format(m.margin,true);
          row.querySelector('[data-tip-status]')!.textContent = stage === 0 && g.key === 'affinity' ? 'Pass, reference baseline' : m.status;
        });
        this.querySelectorAll<HTMLElement>('[data-chemistry]').forEach(cell => {
          cell.textContent = String(state.chemistry[cell.dataset.chemistry as keyof typeof state.chemistry]);
        });
      };
      this.querySelectorAll<HTMLButtonElement>('[data-stage-button]').forEach(b => b.addEventListener('click',() => {
        stage = Number(b.dataset.stageButton); closeTips(); render();
      },{signal}));
      this.querySelectorAll<HTMLButtonElement>('[data-mode-button]').forEach(b => b.addEventListener('click',() => {
        mode = b.dataset.modeButton as Mode; closeTips(); render();
      },{signal}));
      this.querySelectorAll<HTMLElement>('.gate').forEach(row => {
        const button = row.querySelector('button')!;
        button.addEventListener('click',() => {
          const open = !row.classList.contains('pinned'); closeTips();
          row.classList.toggle('pinned',open); button.setAttribute('aria-expanded',String(open));
        },{signal});
      });
      this.addEventListener('keydown',e => { if(e.key==='Escape') { closeTips(); (document.activeElement as HTMLElement)?.blur(); } },{signal});
      this.cleanup = () => { controller.abort(); delete this.dataset.ready; };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if(!customElements.get('lo-task-contract')) customElements.define('lo-task-contract',LoTaskContract);
</script>

<style>
  lo-task-contract { --accent:#087c83; --rust:#ad5a32; --amber:#967020; display:block; width:min(var(--wide-width),var(--breakout-max-width,calc(100vw - 2 * var(--page-gutter)))); margin:var(--space-6) 0; margin-inline:50%; transform:translateX(-50%); color:var(--color-ink); font:13px/1.5 var(--font-sans); }
  figure { margin:0; }
  .context { margin:-10px 0 28px; color:var(--color-ink-soft); font:12px/1.5 var(--font-sans); }
  .context span { margin-inline:6px; }
  button { font:inherit; color:inherit; cursor:pointer; }
  button:focus-visible,summary:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
  .selector { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin:0 0 25px; }
  .selector button { position:relative; display:flex; flex-direction:column; align-items:center; padding:4px 6px 9px; border:0; background:none; text-align:center; color:var(--color-ink-soft); }
  .selector button:not(:last-child)::after { content:''; position:absolute; top:9px; left:calc(50% + 15px); width:calc(100% - 20px); border-top:1px solid var(--color-line); }
  .selector i { width:9px; height:9px; border:1px solid #8c9a95; border-radius:50%; background:var(--color-paper); margin-bottom:9px; transition:background .2s,box-shadow .2s; }
  .selector span { font:14px/1.35 var(--font-sans); }
  .selector small { margin-top:5px; font:10px/1.4 var(--font-mono); }
  .selector [aria-pressed='true'] { color:var(--accent); }
  .selector [aria-pressed='true'] i { background:var(--accent); border-color:var(--accent); box-shadow:0 0 0 4px rgb(8 124 131 / .12); }
  .contract-body { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.1fr); border-block:1px solid var(--color-line); }
  .molecule-panel { padding:23px 26px 24px 0; min-width:0; }
  .eyebrow { color:var(--accent); font:600 11px/1.4 var(--font-mono); letter-spacing:.06em; }
  h3 { margin:4px 0 0; font:23px/1.3 var(--font-serif); }
  .molecule-stage { position:relative; aspect-ratio:520 / 350; width:100%; margin:14px 0; }
  .molecule-stage img { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; opacity:0; transition:opacity .35s ease; pointer-events:none; }
  .molecule-stage img.active { opacity:1; }
  .edit { min-height:42px; margin:0; font:17px/1.4 var(--font-serif); }
  .state-message { border-top:1px solid var(--color-line); padding-top:18px; margin-top:24px; }
  .state-message strong { font:500 20px/1.3 var(--font-serif); }
  .state-message p { margin:9px 0 0; color:var(--color-ink-soft); font:13px/1.6 var(--font-sans); }
  [data-stage='1'] .state-message strong { color:var(--rust); }
  [data-stage='2'] .state-message strong { color:var(--accent); }
  .task-panel { min-width:0; padding:23px 0 20px 26px; border-left:1px solid var(--color-line); }
  .contract-heading { display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .contract-heading h3 { margin:0; font-size:20px; }
  .mode-control { display:flex; gap:12px; }
  .mode-control button { padding:2px 0; border:0; border-bottom:1px solid transparent; background:none; font-size:11px; color:var(--color-ink-soft); }
  .mode-control [aria-pressed='true'] { color:var(--accent); border-bottom-color:var(--accent); }
  .track-key { display:flex; align-items:center; gap:6px; font-size:10px; color:var(--color-ink-soft); margin:9px 0 15px; }
  .track-key i { width:16px; height:6px; background:#d5e8e4; }
  .gate-group h4 { margin:14px 0 6px; font:600 10px/1.5 var(--font-mono); text-transform:uppercase; letter-spacing:.065em; color:var(--accent); }
  .gate-group + .gate-group { border-top:1px solid var(--color-line); margin-top:10px; }
  .gate { position:relative; --tone:#54716a; transition:background-color .25s; }
  .gate[data-tone='fail'] { --tone:var(--rust); background:rgb(173 90 50 / .055); }
  .gate[data-tone='narrow'] { --tone:var(--amber); background:rgb(150 112 32 / .055); }
  .gate[data-tone='unknown'] { --tone:#7d827b; }
  .gate-button { display:block; width:100%; border:0; padding:6px 8px 9px; background:transparent; text-align:left; }
  .gate-top { display:grid; grid-template-columns:1fr auto 19px; gap:9px; align-items:center; }
  .gate-name { font-size:12px; }
  .gate-top strong { font:500 12px/1.4 var(--font-mono); color:var(--tone); }
  .gate-icon { color:var(--tone); text-align:center; font-size:13px; white-space:nowrap; }
  .gate-bottom { display:grid; grid-template-columns:140px 1fr; gap:15px; align-items:center; margin-top:5px; }
  .rule { color:var(--color-ink-soft); font:10px/1.4 var(--font-mono); }
  .track { position:relative; height:4px; background:color-mix(in srgb,var(--color-line) 65%,transparent); }
  .allowed { position:absolute; height:100%; background:#c9e2dc; transition:left .45s ease,width .45s ease; }
  .boundary { position:absolute; width:1px; top:-3px; height:10px; background:#94afa6; transition:left .45s ease; }
  .marker { position:absolute; top:50%; width:7px; height:7px; border:1px solid var(--color-paper); border-radius:50%; background:var(--tone); transform:translate(-50%,-50%); box-shadow:0 0 0 1px var(--tone); transition:left .55s cubic-bezier(.22,.75,.22,1),background-color .3s,box-shadow .3s; }
  .gate-tip { position:absolute; z-index:5; right:0; bottom:calc(100% + 5px); box-sizing:border-box; width:min(310px,100%); padding:12px 14px; border:1px solid var(--color-line); background:var(--color-paper); box-shadow:0 5px 18px #00000015; opacity:0; visibility:hidden; transform:translateY(3px); transition:opacity .12s,transform .12s,visibility .12s; pointer-events:none; }
  .gate:hover .gate-tip,.gate:focus-within .gate-tip,.gate.pinned .gate-tip { opacity:1; visibility:visible; transform:translateY(0); }
  .gate-tip strong { font-size:12px; }
  .gate-tip dl { margin:7px 0; }
  .gate-tip dl div { display:flex; justify-content:space-between; gap:12px; margin:3px 0; }
  .gate-tip dt { color:var(--color-ink-soft); font-size:11px; }
  .gate-tip dd { margin:0; font:10px/1.5 var(--font-mono); }
  .gate-tip p { margin:6px 0 0; color:var(--tone); font-size:11px; }
  .hard-constraints { margin-top:7px; border-top:1px solid var(--color-line); padding-top:8px; }
  summary { cursor:pointer; font-size:12px; }
  summary strong { float:right; color:#54716a; font:500 11px/1.8 var(--font-sans); }
  summary strong span { margin-left:8px; }
  table { width:100%; border-collapse:collapse; margin-top:10px; font:10px/1.5 var(--font-mono); }
  th,td { padding:5px 3px; border-bottom:1px solid var(--color-line); text-align:left; }
  tbody th { font:11px/1.4 var(--font-sans); }
  td:last-child { text-align:right; color:#54716a; }
  .scale-note { color:var(--color-ink-soft); font-size:10px; margin:13px 0 0; }
  .takeaway { margin:0; padding:21px 12px; border-bottom:1px solid var(--color-line); text-align:center; font:19px/1.5 var(--font-serif); }
  [hidden] { display:none!important; }
  @media(max-width:740px) {
    .contract-body { grid-template-columns:1fr; }
    .molecule-panel { padding:20px 0; }
    .task-panel { border-left:0; border-top:1px solid var(--color-line); padding:20px 0; }
    .molecule-stage { max-width:440px; margin:0 auto; }
    .selector span { font-size:11px; }
    .selector small { font-size:9px; }
    .edit { min-height:0; }
    .state-message { margin-top:17px; }
    .takeaway { font-size:18px; }
  }
  @media(prefers-reduced-motion:reduce) {
    .selector i,.molecule-stage img,.gate,.allowed,.boundary,.marker,.gate-tip { transition:none; }
  }
</style>
