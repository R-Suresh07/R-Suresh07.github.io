---
import type { NewsItem } from '../data/news';

interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;

const formatDate = (date: string) => new Intl.DateTimeFormat('en', {
  month: 'short',
  day: '2-digit',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
---

<ol class="news-list">
  {items.map((item) => (
    <li class:list={{ milestone: item.html.toLowerCase().includes('accepted') }}>
      <time datetime={item.date}>{formatDate(item.date)}</time>
      <p set:html={item.html} />
    </li>
  ))}
</ol>

<style>
  .news-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }

  li::before {
    position: absolute;
    top: 1.53rem;
    left: 0;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: var(--green);
    content: '';
  }

  time {
    padding-left: 0.9rem;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: clamp(0.7rem, 0.68rem + 0.06vw, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  p {
    margin: 0;
  }

  .milestone::before {
    background: var(--purple);
  }

  .milestone time,
  .milestone :global(strong) {
    color: var(--purple);
  }

  @media (max-width: 40rem) {
    li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
