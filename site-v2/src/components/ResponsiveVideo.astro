---
import FigureHeading from './FigureHeading.astro';
import FigureCaption from './FigureCaption.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  subtitle?: string;
  mode: 'figure' | 'player';
  webm?: string;
  mp4?: string;
  poster?: ImageMetadata | string;
  label: string;
  width?: 'prose' | 'wide' | 'full';
  captionLabel?: string;
  caption?: string;
  credit?: string;
  source?: string;
}

const {
  title,
  subtitle,
  mode,
  webm,
  mp4,
  poster,
  label,
  width = 'wide',
  captionLabel,
  caption,
  credit,
  source,
} = Astro.props;

const posterUrl = typeof poster === 'string' ? poster : poster?.src;
const isFigure = mode === 'figure';
---

<figure class:list={['video-figure', `video-figure--${width}`]}>
  <FigureHeading label={captionLabel} title={title ?? caption} subtitle={subtitle} />
  <video
    aria-label={label}
    autoplay={isFigure}
    muted={isFigure}
    loop={isFigure}
    playsinline={isFigure}
    controls={!isFigure}
    preload={isFigure ? 'metadata' : 'none'}
    poster={posterUrl}
  >
    {webm && <source src={webm} type="video/webm" />}
    {mp4 && <source src={mp4} type="video/mp4" />}
    Your browser does not support embedded video.
  </video>
  <FigureCaption caption={title ? caption : undefined} credit={credit} source={source} />
</figure>

<style>
  .video-figure {
    --media-width: var(--wide-width);
    width: min(
      var(--media-width),
      var(--breakout-max-width, calc(100vw - (2 * var(--page-gutter))))
    );
    margin-block: var(--space-6);
    margin-inline: 50%;
    transform: translateX(-50%);
  }

  .video-figure--prose {
    --media-width: var(--measure);
  }

  .video-figure--full {
    --media-width: var(--full-width);
  }

  video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-line);
    background: var(--color-paper-raised);
    object-fit: cover;
  }

</style>
