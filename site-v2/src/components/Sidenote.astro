---
interface Props {
  number: string;
  align?: 'marker' | 'paragraph';
}

const { number, align = 'marker' } = Astro.props;
---

<span class="sidenote">
  <sup><a href={`#sidenote-${number}`} id={`sidenote-ref-${number}`} aria-label={`Read sidenote ${number}`}>{number}</a></sup>
  <span class="sidenote-content" id={`sidenote-${number}`} role="note" data-align={align}>
    <span class="sidenote-label">{number}.</span> <slot />
  </span>
</span>

<style>
  .sidenote {
    position: static;
  }

  sup a {
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 0.7em;
    font-weight: 700;
    text-decoration: none;
  }

  .sidenote-content {
    display: block;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: calc(var(--text-sm) * 0.94);
    font-style: normal;
    font-weight: 400;
    line-height: 1.45;
    margin: var(--space-2) 0 0;
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-line);
  }

  .sidenote-content.is-margin {
    position: absolute;
    width: 14rem;
    margin: 0;
    padding: 0;
    border: 0;
    scroll-margin-top: var(--space-4);
  }

  .sidenote-label {
    color: var(--color-accent);
    font-weight: 700;
  }

  @media (max-width: 80rem) {
    .sidenote-content {
      position: static;
      width: auto;
    }
  }
</style>

<script>
  const positionSidenotes = () => {
    let previousMarginBottom = Number.NEGATIVE_INFINITY;
    document.querySelectorAll<HTMLElement>('.sidenote-content').forEach((note) => {
      const marker = note.parentElement?.querySelector('sup');
      const prose = note.closest<HTMLElement>('.prose');
      const useMargin = window.matchMedia('(min-width: 80.0625rem)').matches;

      note.classList.toggle('is-margin', Boolean(marker && prose && useMargin));
      if (!marker || !prose || !useMargin) {
        note.style.removeProperty('top');
        note.style.removeProperty('left');
        return;
      }

      const rootFontSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize);
      const marginGap = rootFontSize * 3.25;
      const proseRect = prose.getBoundingClientRect();
      const offsetParentRect = note.offsetParent?.getBoundingClientRect();
      const desiredLeft = proseRect.right + marginGap;
      const fitsViewport = desiredLeft + note.offsetWidth <= document.documentElement.clientWidth - 8;

      if (!offsetParentRect || !fitsViewport) {
        note.classList.remove('is-margin');
        note.style.removeProperty('top');
        note.style.removeProperty('left');
        return;
      }

      note.style.left = `${desiredLeft - offsetParentRect.left}px`;
      const markerTop = marker.getBoundingClientRect().top;
      const offsetParentTop = offsetParentRect.top;
      let desiredTop: number;
      const paragraph = note.closest('p');
      if (note.dataset.align === 'paragraph' && paragraph) {
        desiredTop = paragraph.getBoundingClientRect().top;
      } else {
        const paragraphBottom = paragraph ? paragraph.getBoundingClientRect().bottom : markerTop + note.offsetHeight;
        desiredTop = Math.min(markerTop, paragraphBottom - note.offsetHeight);
      }
      desiredTop = Math.max(desiredTop, previousMarginBottom + 24);
      note.style.top = `${desiredTop - offsetParentTop}px`;
      previousMarginBottom = desiredTop + note.offsetHeight;
    });
  };

  let pendingFrame: number | null = null;
  const scheduleSidenotePositioning = () => {
    if (pendingFrame !== null) cancelAnimationFrame(pendingFrame);
    pendingFrame = requestAnimationFrame(() => {
      pendingFrame = null;
      positionSidenotes();
    });
  };

  scheduleSidenotePositioning();
  document.fonts?.ready.then(scheduleSidenotePositioning);
  window.addEventListener('load', scheduleSidenotePositioning, { once: true });
  window.addEventListener('resize', scheduleSidenotePositioning);

  const sidenoteResizeObserver = new ResizeObserver(scheduleSidenotePositioning);
  document.querySelectorAll<HTMLElement>('.sidenote-content').forEach(note => sidenoteResizeObserver.observe(note));
</script>
