---
interface Props { caption?: string; credit?: string; source?: string; }
const { caption, credit, source } = Astro.props;
---
{(caption || credit || source) && <figcaption class="editorial-figure-caption">
  {caption && <span>{caption}</span>}
  {(credit || source) && <small>{credit && <span>{credit}</span>}{source && <a href={source}>Source</a>}</small>}
</figcaption>}
<style>
  .editorial-figure-caption { margin:24px 0 0; color:var(--color-ink-soft); font:13px/1.8 var(--font-sans); }
  small { display:flex; flex-wrap:wrap; gap:12px; margin-top:6px; font:inherit; }
</style>
