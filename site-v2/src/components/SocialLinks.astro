---
import { socials } from '../data/socials';

interface Props {
  labelled?: boolean;
}

const { labelled = false } = Astro.props;
---

<ul class:list={['social-links', { 'social-links--labelled': labelled }]} aria-label="Social and contact links">
  {socials.map((social) => (
    <li>
      <a href={social.href}>
        <span>{social.label}</span>
        {labelled && <small>{social.username}</small>}
      </a>
    </li>
  ))}
</ul>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    list-style: none;
  }

  a {
    font-weight: 650;
    text-decoration: none;
  }

  .social-links--labelled {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--color-line);
  }

  .social-links--labelled li {
    border-bottom: 1px solid var(--color-line);
  }

  .social-links--labelled li:nth-child(odd) {
    padding-right: var(--space-3);
  }

  .social-links--labelled li:nth-child(even) {
    padding-left: var(--space-3);
  }

  .social-links--labelled a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }

  small {
    min-width: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  @media (max-width: 42rem) {
    .social-links--labelled {
      grid-template-columns: 1fr;
    }

    .social-links--labelled li:nth-child(n) {
      padding-inline: 0;
    }
  }
</style>
