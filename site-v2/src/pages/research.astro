---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PublicationList from '../components/PublicationList.astro';
import { publications } from '../data/publications';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) => new Intl.DateTimeFormat('en', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout title="Research" description="Publications and projects.">
  <div class="site-shell page research-page">
    <header class="page-narrow">
      <h1 class="page-title">Publications and projects</h1>
    </header>

    <section class="research-section" aria-labelledby="publications">
      <h2 id="publications">Publications</h2>
      <PublicationList items={publications} />
    </section>

    <section class="research-section projects" aria-labelledby="projects">
      <h2 id="projects">Selected Projects</h2>
      <div class="project-list">
      {projects.map((project) => (
        <article class="project">
          <button
            class="project-image"
            type="button"
            aria-label={`Open a larger preview of ${project.data.title}`}
            aria-haspopup="dialog"
            data-project-lightbox-open={`project-lightbox-${project.id}`}
          >
            <Image
              src={project.data.image}
              alt=""
              widths={[320, 640]}
              sizes="(max-width: 42rem) 20rem, 20rem"
              loading="lazy"
            />
            <span class="zoom-hint" aria-hidden="true">View larger</span>
          </button>
          <div class="project-copy">
            <p class="meta">
              {formatDate(project.data.date)}<span aria-hidden="true"> · </span>{project.data.category}
            </p>
            <h3>{project.data.title}</h3>
            <p class="project-description">{project.data.description}</p>
            <ul class="project-links" aria-label={`${project.data.title} links`}>
              {project.data.links.map((link) => (
                <li><span>{link.label}: </span><a href={link.href}>{link.text}</a></li>
              ))}
            </ul>
          </div>
          <dialog
            class="project-lightbox"
            id={`project-lightbox-${project.id}`}
            aria-label={`${project.data.title} preview`}
          >
            <form method="dialog">
              <button class="lightbox-close" type="submit">Close</button>
            </form>
            <div class="lightbox-image">
              <Image
                src={project.data.image}
                alt={`${project.data.title} project preview`}
                loading="lazy"
                widths={[720, 1200, 1600]}
                sizes="min(92vw, 80rem)"
              />
            </div>
            <p>{project.data.title}</p>
          </dialog>
        </article>
      ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-project-lightbox-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialogId = button.dataset.projectLightboxOpen;
      if (!dialogId) return;

      const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('.project-lightbox').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .research-page {
    padding-top: var(--space-6);
  }

  .research-section {
    margin-top: var(--space-7);
  }

  .research-section:first-of-type {
    margin-top: var(--space-5);
  }

  .research-section > h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
    font-weight: 520;
    letter-spacing: -0.03em;
  }

  .project {
    display: grid;
    grid-template-columns: 20rem minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }

  .project-list {
    border-top: 1px solid var(--color-line);
  }

  .project-image {
    display: grid;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-line);
    background: var(--color-paper-raised);
    color: var(--color-ink);
    cursor: zoom-in;
    place-items: center;
    overflow: hidden;
    text-align: left;
  }

  .project-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-image:hover,
  .project-image:focus-visible {
    border-color: var(--green);
  }

  .zoom-hint {
    position: absolute;
    right: var(--space-1);
    bottom: var(--space-1);
    padding: 0.15rem 0.35rem;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    color: var(--green-dark);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateY(0.2rem);
    transition: opacity 140ms ease-out, transform 140ms ease-out;
  }

  .project-image:hover .zoom-hint,
  .project-image:focus-visible .zoom-hint {
    opacity: 1;
    transform: translateY(0);
  }

  .project-lightbox {
    width: min(92vw, 80rem);
    max-width: none;
    max-height: 92vh;
    margin: auto;
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    background: var(--bg);
    color: var(--color-ink);
    overflow: auto;
  }

  .project-lightbox::backdrop {
    background: color-mix(in srgb, var(--ink) 72%, transparent);
  }

  .project-lightbox form {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-3);
  }

  .lightbox-close {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--green);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 650;
    cursor: pointer;
  }

  .lightbox-close:hover {
    color: var(--green-dark);
  }

  .lightbox-image {
    display: grid;
    min-height: min(65vh, 44rem);
    place-items: center;
  }

  .lightbox-image :global(img) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 72vh;
    object-fit: contain;
  }

  .project-lightbox > p {
    margin: var(--space-3) 0 0;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .project h3 {
    max-width: 30ch;
    margin: var(--space-2) 0 0;
    font-size: var(--text-lg);
    font-weight: 520;
    letter-spacing: -0.02em;
    line-height: 1.24;
  }

  .project-description {
    max-width: 58ch;
    margin: var(--space-2) 0 0;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    list-style: none;
  }

  .project-links span {
    color: var(--color-ink-soft);
  }

  .project-links a {
    font-weight: 650;
  }

  @media (max-width: 42rem) {
    .research-page {
      padding-top: var(--space-5);
    }

    .project {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .project-image {
      width: min(100%, 20rem);
    }

    .project-lightbox {
      width: calc(100vw - (2 * var(--page-gutter)));
      padding: var(--space-3);
    }

    .lightbox-image {
      min-height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zoom-hint {
      transition: none;
    }
  }
</style>
