---
import { Image } from 'astro:assets';
import profileImage from '../assets/images/profile/profile.jpeg';
import NewsList from '../components/NewsList.astro';
import PublicationList from '../components/PublicationList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { news } from '../data/news';
import { publications } from '../data/publications';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const updates = [...news].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title={site.name} description={site.description}>
  <div class="site-shell page home">
    <div class="home-grid">
      <div class="introduction">
        <p class="eyebrow">{site.availability}</p>
        <h1>{site.name}</h1>
        <p class="role">{site.role}</p>
        <div class="biography">
          {site.biography.map((paragraph) => <p set:html={paragraph} />)}
        </div>
        <SocialLinks />
      </div>

      <aside class="profile">
        <div class="portrait-frame">
          <Image
            src={profileImage}
            alt={`Portrait of ${site.name}`}
            widths={[320, 520, 720, 900]}
            sizes="(max-width: 48rem) 52vw, 25rem"
            loading="eager"
          />
        </div>
        <p>{site.location}<span aria-hidden="true"> · </span>{site.photoNote}</p>
      </aside>
    </div>

    <section class="home-section" aria-labelledby="news">
      <div class="section-heading">
        <h2 id="news">News</h2>
      </div>
      <NewsList items={updates} />
    </section>

    <section class="home-section" aria-labelledby="selected-publications">
      <div class="section-heading">
        <h2 id="selected-publications">Selected publications</h2>
        <a class="text-link" href="/research/">All research</a>
      </div>
      <PublicationList items={publications.filter((publication) => publication.selected)} compact />
    </section>

  </div>
</BaseLayout>

<style>
  .home {
    padding-top: clamp(var(--space-6), 6vw, var(--space-7));
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(19rem, 0.9fr);
    gap: var(--space-6) clamp(2rem, 3.5vw, 3.5rem);
    align-items: start;
  }

  .introduction {
    max-width: 70ch;
  }

  .introduction > .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--purple);
  }

  .introduction > .eyebrow::before {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--purple);
    content: '';
    flex: none;
  }

  h1 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: var(--line-height-tight);
  }

  .role {
    margin: var(--space-3) 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
    line-height: 1.45;
  }

  .biography {
    margin-block: 1.9rem var(--space-5);
    font-size: var(--text-base);
  }

  .biography p {
    margin-block: 0 1em;
  }

  .profile {
    padding: 0 0.5rem 0.5rem 0;
  }

  .portrait-frame {
    position: relative;
    isolation: isolate;
  }

  .portrait-frame::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--green-soft);
    content: '';
    transform: translate(0.5rem, 0.5rem);
    transform-origin: top right;
    transition: transform 380ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .portrait-frame :global(img) {
    position: relative;
    width: 100%;
    height: auto;
    border: 1px solid color-mix(in srgb, var(--green) 24%, var(--line));
    transform-origin: bottom left;
    transition: transform 380ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .portrait-frame:hover :global(img) {
      transform: translate(-0.55rem, -0.18rem) rotate(-1.35deg);
    }

    .portrait-frame:hover::after {
      transform: translate(0.85rem, 0.45rem) rotate(0.75deg);
    }
  }

  .profile p {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }

  .home-section {
    margin-top: var(--space-8);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .section-heading h2 {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 520;
    letter-spacing: -0.03em;
  }

  @media (max-width: 48rem) {
    .home-grid {
      grid-template-columns: 1fr;
    }

    .profile {
      width: min(52vw, 15rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait-frame :global(img) {
      transition: none;
    }

    .portrait-frame::after {
      transition: none;
    }

    .portrait-frame:hover :global(img) {
      transform: none;
    }

    .portrait-frame:hover::after {
      transform: translate(0.5rem, 0.5rem);
    }
  }
</style>
