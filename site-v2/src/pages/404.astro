---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <div class="site-shell page">
    <div class="page-narrow">
      <p class="eyebrow">404</p>
      <h1 class="page-title">This page does not exist.</h1>
      <p class="page-intro">The address may have changed, or the page may still be taking shape.</p>
      <p class="home-link"><a class="text-link" href="/">Return home</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .home-link {
    margin-top: var(--space-5);
  }
</style>
