---
import {
  cvEducation,
  cvExperience,
  cvPdfUrl,
  cvProjects,
  cvPublicationDetails,
  cvSkills,
} from '../data/cv';
import { publications } from '../data/publications';
import BaseLayout from '../layouts/BaseLayout.astro';

const cvPublications = cvPublicationDetails.map((detail) => {
  const publication = publications.find((item) => item.eprint === detail.eprint);

  if (!publication) {
    throw new Error(`Missing canonical publication metadata for arXiv:${detail.eprint}`);
  }

  return { detail, publication };
});
---

<BaseLayout title="CV" description="Curriculum vitae for Suresh Raghu.">
  <div class="site-shell page cv-page">
    <header class="cv-header">
      <p class="eyebrow">Curriculum vitae</p>
      <h1 class="page-title">Suresh Raghu</h1>
      <p class="cv-actions">
        <a class="download-link" href={cvPdfUrl} download="Suresh_Raghu_CV.pdf">Download CV <span aria-hidden="true">↓</span></a>
      </p>
    </header>

    <section class="cv-section" aria-labelledby="education">
      <h2 id="education">Education</h2>
      <ol class="cv-list">
        {cvEducation.map((entry) => (
          <li class="cv-row">
            <p class="date-meta">{entry.dates}</p>
            <div class="cv-entry">
              <div class="entry-heading">
                <h3><a href={entry.institutionUrl}>{entry.institution}</a></h3>
                <p>{entry.location}</p>
              </div>
              <p class="role">{entry.degree}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="cv-section" aria-labelledby="publications">
      <h2 id="publications">Publications</h2>
      <ol class="cv-list publication-list">
        {cvPublications.map(({ detail, publication }) => (
          <li class="cv-row">
            <p class="date-meta">{publication.year}</p>
            <div class="cv-entry">
              <div class="publication-heading">
                <h3><a href={publication.url}>{publication.title}</a></h3>
              </div>
              <p class="authors">
                {publication.authors.map((author, index) => (
                  <span class:list={{ self: author === 'Suresh Raghu' }}>
                    {author}{publication.equalContribution?.includes(author) && <sup>*</sup>}{index < publication.authors.length - 1 ? ', ' : ''}
                  </span>
                ))}
              </p>
              <p class="venue">
                {detail.venue}
              </p>
              <ul class="publication-links" aria-label={`Resources for ${publication.title}`}>
                <li><a href={publication.url}>Paper <span class="sr-only">for {publication.title}</span></a></li>
                {detail.code && <li><a href={detail.code}>Code <span class="sr-only">for {publication.title}</span></a></li>}
                {publication.poster && <li><a href={publication.poster}>Poster <span class="sr-only">for {publication.title}</span></a></li>}
              </ul>
            </div>
          </li>
        ))}
      </ol>
      <p class="contribution-note">* Equal contribution</p>
    </section>

    <section class="cv-section" aria-labelledby="experience">
      <h2 id="experience">Research &amp; Engineering Experience</h2>
      <ol class="cv-list">
        {cvExperience.map((entry) => (
          <li class="cv-row">
            <p class="date-meta">{entry.dates}</p>
            <div class="cv-entry">
              <div class="entry-heading">
                <h3><a href={entry.organizationUrl}>{entry.organization}</a></h3>
                <p>{entry.location}</p>
              </div>
              <p class="role">{entry.role}</p>
              {entry.advisors && <p class="advisors"><strong>Advisors:</strong> {entry.advisors}</p>}
              <ul class="highlights">
                {entry.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="cv-section" aria-labelledby="research-projects">
      <h2 id="research-projects">Selected Research Projects</h2>
      <ol class="cv-list project-list">
        {cvProjects.map((entry) => (
          <li class="project-row">
            <div class="cv-entry project-heading">
              <h3><a href={entry.url}>{entry.title}</a></h3>
              <p class="role">{entry.context}</p>
              <a class="project-link" href={entry.url}>Read {entry.linkLabel.toLowerCase()}<span class="sr-only">: {entry.title}</span> <span aria-hidden="true">↗</span></a>
            </div>
            <ul class="highlights project-highlights">
              {entry.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="cv-section" aria-labelledby="technical-skills">
      <h2 id="technical-skills">Technical Skills</h2>
      <dl class="skills-list">
        {cvSkills.map((skill) => (
          <div class="skill-row">
            <dt>{skill.category}</dt>
            <dd>{skill.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .cv-page {
    padding-top: var(--space-6);
  }

  .cv-header {
    width: min(100%, var(--measure));
  }

  .cv-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-accent);
    border-radius: 0.25rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .download-link:hover,
  .download-link:focus-visible {
    background: var(--color-accent);
    color: var(--color-paper);
  }

  .publication-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    margin: var(--space-3) 0 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .publication-links,
  .project-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .cv-section {
    margin-top: var(--space-7);
  }

  .cv-header + .cv-section {
    margin-top: var(--space-6);
  }

  .cv-section > h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
    font-weight: 520;
    letter-spacing: -0.03em;
  }

  .cv-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .cv-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.24fr) minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }

  .date-meta {
    margin: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .entry-heading,
  .publication-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .cv-entry h3 {
    max-width: 42ch;
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 520;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .cv-entry h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .cv-entry h3 a:hover,
  .cv-entry h3 a:focus-visible {
    color: var(--color-accent);
  }

  .entry-heading > p {
    flex: 0 0 auto;
    margin: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .venue {
    color: var(--purple);
  }

  .role,
  .authors,
  .venue {
    max-width: 68ch;
  }

  .role {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-soft);
  }

  .advisors {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .highlights {
    max-width: 70ch;
    margin: var(--space-3) 0 0;
    padding-left: 1.15rem;
  }

  .highlights li {
    margin-top: var(--space-2);
    line-height: 1.55;
  }

  .highlights li:first-child {
    margin-top: 0;
  }

  .highlights strong {
    font-weight: 650;
  }

  .authors {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-soft);
  }

  .authors .self {
    color: var(--color-ink);
    font-weight: 700;
  }

  .authors sup {
    font-family: var(--font-sans);
    font-size: 0.68em;
  }

  .venue {
    margin: var(--space-2) 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .venue a {
    font-weight: 650;
  }

  .contribution-note {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }

  .project-row h3 {
    max-width: none;
  }

  .project-heading .role {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .project-highlights {
    max-width: none;
    margin: 0;
    padding-left: 1.15rem;
  }

  .project-highlights li::marker {
    color: var(--color-accent);
  }

  .project-highlights li + li {
    margin-top: var(--space-3);
  }

  .skills-list {
    margin: 0;
    border-top: 1px solid var(--color-line);
  }

  .skill-row {
    display: grid;
    grid-template-columns: minmax(12rem, 0.4fr) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }

  .skill-row dt {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .skill-row dd {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 42rem) {
    .cv-page {
      padding-top: var(--space-5);
    }

    .cv-row,
    .skill-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding-block: var(--space-4);
    }

    .entry-heading,
    .publication-heading {
      display: block;
    }

    .entry-heading > p {
      margin-top: var(--space-1);
    }
  }
</style>
